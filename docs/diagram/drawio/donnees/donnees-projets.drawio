        </mxCell>
        <mxCell id="e-ent-need-ent-actor" value="createdBy, decidedBy, filledBy · SetNull" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="ent-need" target="ent-actor">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-need-ent-opportunity" value="0..1 ↔ 0..1 · unique · SetNull" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="ent-need" target="ent-opportunity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-need-ent-instrument" value="N → 0..1 · SetNull" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="ent-need" target="ent-instrument">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-need-ent-participant" value="filledBy : participation active, non liée" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="ent-need" target="ent-participant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-act-ent-project" value="N → 1 · Cascade" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="ent-act" target="ent-project">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-act-ent-actor" value="author, subject · SetNull" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="ent-act" target="ent-actor">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-act-ent-need" value="needId sans FK" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="ent-act" target="ent-need">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ent-act-ent-work" value="workId sans FK" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="ent-act" target="ent-work">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
