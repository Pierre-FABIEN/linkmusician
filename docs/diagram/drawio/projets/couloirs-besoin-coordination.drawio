        <mxCell id="g-decide" value="Ouvrir ce besoin (après retouche éventuelle)" style="rounded=1;whiteSpace=wrap;html=0;lm=step;lmTone=violet;" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="g-decline" value="Ne pas retenir" style="rounded=1;whiteSpace=wrap;html=0;dashed=1;lm=step;lmTone=violet;" vertex="1" parent="1">
