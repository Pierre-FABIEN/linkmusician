          <mxGeometry x="300" y="440" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="df-access" value="`projectAccess` : rôle relu sous verrou" style="rounded=1;whiteSpace=wrap;html=0;lm=step;lmTone=paper;" vertex="1" parent="1">
          <mxGeometry x="300" y="550" width="240" height="64" as="geometry"/>
        </mxCell>
