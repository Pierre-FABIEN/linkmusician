<mxfile host="Melokiva" agent="docs/diagram/conventions.md" version="24.0.0">
  <diagram id="dataflow-besoin-ajouter" name="Dataflow : ajouter un besoin">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="grp-transaction" value="Transaction Prisma (15 s) : ROLLBACK sur toute ProjectError" style="rounded=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;lm=group;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="680" height="645" as="geometry"/>
        </mxCell>
        <mxCell id="df-form" value="Formulaire « Ajouter un besoin » (POST ?/besoin-ajouter)" style="rounded=1;whiteSpace=wrap;html=0;lm=step;lmTone=violet;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="240" height="64" as="geometry"/>
        </mxCell>
