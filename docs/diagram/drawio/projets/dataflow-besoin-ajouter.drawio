        </mxCell>
        <mxCell id="df-lock-author" value="Transaction Prisma, verrou `project-need-author:&lt;personne&gt;`" style="rounded=1;whiteSpace=wrap;html=0;lm=step;lmTone=paper;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="240" height="64" as="geometry"/>
        </mxCell>
