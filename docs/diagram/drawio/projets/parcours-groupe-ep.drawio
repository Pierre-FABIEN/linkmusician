        </mxCell>
        <mxCell id="e-need-add-alt-quota" value="" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="need-add" target="alt-quota">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-need-search-contact-first" value="personne trouvée" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="need-search" target="contact-first">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-need-search-alt-no-opportunity" value="annonce ?" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="need-search" target="alt-no-opportunity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-need-search-invite-handle" value="majeur·e" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="need-search" target="invite-handle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-contact-first-contact-accept" value="" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="contact-first" target="contact-accept">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-contact-accept-invite" value="" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="contact-accept" target="invite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-invite-handle-invite" value="" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="invite-handle" target="invite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-invite-invite-answer" value="" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="invite" target="invite-answer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-invite-alt-invite-refused" value="refus" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="invite" target="alt-invite-refused">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-invite-answer-need-fill" value="" style="endArrow=block;html=0;lm=edge;" edge="1" parent="1" source="invite-answer" target="need-fill">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-invite-answer-invite-declined" value="non" style="endArrow=block;html=0;dashed=1;lm=edge;" edge="1" parent="1" source="invite-answer" target="invite-declined">
          <mxGeometry relative="1" as="geometry"/>
