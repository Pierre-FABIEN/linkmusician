<mxfile host="app.diagrams.net" modified="2026-11-19T04:55:00.000Z" agent="Melokiva editorial" version="24.7.17" type="device"><diagram id="melokiva-1" name="01 - Parcours relationnel"><mxGraphModel dx="1750" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MELOKIVA  |  Naissance et évolution des relations" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=31;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1560" height="52" as="geometry" /></mxCell><mxCell id="subtitle" value="PARCOURS 01 · De la découverte à la collaboration vérifiée  ·  Situation au 19 novembre 2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#51627D;" vertex="1" parent="1"><mxGeometry x="55" y="66" width="1550" height="30" as="geometry" /></mxCell><mxCell id="note0" value="01  ·  PROFIL ET DÉCOUVERTE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontStyle=1;fontColor=#2467C9;" vertex="1" parent="1"><mxGeometry x="58" y="84" width="1570" height="34" as="geometry" /></mxCell><mxCell id="note1" value="02  ·  UNE RENCONTRE NE SUFFIT PAS À PROUVER UNE COLLABORATION" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontStyle=1;fontColor=#168469;" vertex="1" parent="1"><mxGeometry x="58" y="274" width="1570" height="34" as="geometry" /></mxCell><mxCell id="note2" value="03  ·  L’OPPORTUNITÉ CRÉE UN ÉCHANGE, PAS UNE PREUVE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontStyle=1;fontColor=#7848C5;" vertex="1" parent="1"><mxGeometry x="58" y="484" width="1570" height="34" as="geometry" /></mxCell><mxCell id="note3" value="04  ·  LE TRAVAIL CONFIRMÉ DEVIENT UN FAIT RECONNU" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontStyle=1;fontColor=#C56A25;" vertex="1" parent="1"><mxGeometry x="58" y="687" width="1570" height="34" as="geometry" /></mxCell><mxCell id="note4" value="05  ·  LE PROJET EST FACULTATIF ET INDÉPENDANT DE LA PREUVE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontStyle=1;fontColor=#2467C9;" vertex="1" parent="1"><mxGeometry x="58" y="897" width="1570" height="34" as="geometry" /></mxCell><mxCell id="note5" value="SOLIDE  =  parcours existant     - - -  =  extension prévue     ·     Jam ≠ présence  ·  Projet ≠ crédit  ·  XP ≠ droit" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=0;fontColor=#51627D;" vertex="1" parent="1"><mxGeometry x="64" y="1110" width="1564" height="34" as="geometry" /></mxCell><mxCell id="profil" value="Je crée mon profil&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Métier(s) · instruments · zone · intentions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#EAF2FF;strokeColor=#2467C9;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="132" width="325" height="114" as="geometry" /></mxCell><mxCell id="chercher" value="Je découvre des personnes&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Recherche, métiers, proximité et offres&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#EAF2FF;strokeColor=#2467C9;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="482" y="132" width="325" height="114" as="geometry" /></mxCell><mxCell id="jam" value="Je trouve une jam&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Lieu et créneau · invitation possible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E7F7EF;strokeColor=#168469;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="899" y="132" width="325" height="114" as="geometry" /></mxCell><mxCell id="dispo" value="Je me rends disponible&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Ce soir, demain ou week-end&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E7F7EF;strokeColor=#168469;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1316" y="132" width="280" height="114" as="geometry" /></mxCell><mxCell id="inscrit" value="Je m’inscris à la jam&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Invitation acceptée ou « Je viens »&lt;br&gt;≠ présence réelle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E7F7EF;strokeColor=#168469;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="325" width="330" height="123" as="geometry" /></mxCell><mxCell id="presence" value="Présence constatée&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;On distingue présence et intention&lt;br&gt;de participation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E7F7EF;strokeColor=#168469;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="325" width="330" height="123" as="geometry" /></mxCell><mxCell id="apprecier" value="Après-jam&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Appréciation éligible, carnet,&lt;br&gt;« Garder le contact »&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E7F7EF;strokeColor=#168469;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="885" y="325" width="330" height="123" as="geometry" /></mxCell><mxCell id="contact" value="Contact musical&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Personne rencontrée ou&lt;br&gt;conversation réciproque&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E7F7EF;strokeColor=#168469;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1295" y="325" width="300" height="123" as="geometry" /></mxCell><mxCell id="annonce" value="Annonce / besoin&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Je cherche un membre, une session&lt;br&gt;ou une prestation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#F3ECFF;strokeColor=#7848C5;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="535" width="330" height="116" as="geometry" /></mxCell><mxCell id="candidature" value="Candidature&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;La personne postule ; la gestion&lt;br&gt;accepte ou refuse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#F3ECFF;strokeColor=#7848C5;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="535" width="330" height="116" as="geometry" /></mxCell><mxCell id="conversation" value="Conversation&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;L’acceptation ouvre un échange ;&lt;br&gt;la réponse le rend réciproque&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#F3ECFF;strokeColor=#7848C5;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="885" y="535" width="330" height="116" as="geometry" /></mxCell><mxCell id="proposition" value="Proposition de collaboration&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Les parties déclarent un travail&lt;br&gt;passé ou prévu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#F3ECFF;strokeColor=#7848C5;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1295" y="535" width="300" height="116" as="geometry" /></mxCell><mxCell id="acceptation" value="Accord si date future&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Pour une date passée, proposer vaut&lt;br&gt;confirmation de son côté&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#FFF0DF;strokeColor=#C56A25;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="740" width="330" height="116" as="geometry" /></mxCell><mxCell id="confirmation" value="Confirmation des deux côtés&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Après réalisation ; refus ou annulation&lt;br&gt;empêche la validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#FFF0DF;strokeColor=#C56A25;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="740" width="330" height="116" as="geometry" /></mxCell><mxCell id="realisation" value="Fait professionnel reconnu&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Collaboration terminée · crédit sur&lt;br&gt;morceau si conditions remplies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#FFF0DF;strokeColor=#C56A25;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="885" y="740" width="330" height="116" as="geometry" /></mxCell><mxCell id="carriere" value="Contributions et carrière&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Historique, objectifs, suggestions ;&lt;br&gt;XP selon règles métier&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#E4F7F7;strokeColor=#137E89;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1295" y="740" width="300" height="116" as="geometry" /></mxCell><mxCell id="groupe" value="Groupe musical&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Adhésion acceptée · rôles OWNER,&lt;br&gt;ADMIN ou MEMBER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#EAF2FF;strokeColor=#2467C9;strokeWidth=1.6;fontFamily=Arial;fontSize=18;fontColor=#15233D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="952" width="330" height="115" as="geometry" /></mxCell><mxCell id="projet" value="Projet musical&lt;br&gt;&lt;font color=&quot;#51627D&quot; style=&quot;font-size:12px&quot;&gt;Un acteur le porte ; EP, album,&lt;br&gt;tournée, production…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;fillColor=#EAF2FF;strokeColor=#2467C9;strokeW