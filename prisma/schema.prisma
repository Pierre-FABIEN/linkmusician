datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // LINKMUSICIAN: une seule URL dans `.env`, celle du pooler Neon. Les
  // migrations, elles, ne passent JAMAIS par le pooler (il transmet le schéma
  // d'une connexion à l'autre) : `npm run db:migrate` / `db:deploy` /
  // `db:status` / `reset` passent par `scripts/prisma-direct.mjs`, qui en
  // déduit l'URL directe. Ne pas lancer `npx prisma migrate …` directement.
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
  /// LINKMUSICIAN: traite les signalements et la file de modération, sans les droits d'administration.
  MODERATOR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

// PROMO-PLUGIN
enum PromoType {
  PERCENTAGE
  FIXED
}

// PRODUCT-PLUGIN : type de donnée d'une taxonomie, détermine la saisie/l'affichage
// (déduit automatiquement côté UI, jamais configuré séparément du type).
enum TaxonomyType {
  TEXT
  COLOR
  NUMBER
  BOOLEAN
  DATE
}

/// Statut d'une demande de retour (`ReturnRequest`), voir StoreSettings.returnsEnabled.
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
  /// Alternative à REFUNDED : crédité sous forme de solde `GiftCard` au lieu
  /// d'un remboursement Stripe (voir `ReturnRequest.giftCardId`).
  CREDITED
}

/// Distingue la rétractation légale (Code conso. L221-18 à L221-28 : 14
/// jours, sans motif à fournir) d'un retour SAV/garantie classique — même
/// flux d'approbation ensuite (`ReturnRequest.status`), seule la nature de
/// la demande change.
enum ReturnKind {
  WITHDRAWAL
  WARRANTY
}

// AUTH __________________________________________________________________________________
//
// AUTH-PLUGIN : `Session`, `EmailVerificationRequest` et `PasswordResetSession`
// n'existent que pour l'authentification et se suppriment ensemble.
//
// `User` est en revanche partagé : le commerce s'y rattache (`Address`, `Order`,
// `Transaction`). Retirer l'authentification revient donc à retirer ses champs
// d'identification, pas la table. Voir docs/auth/retrait.md.

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Facultatif : un compte créé via Google n'en possède pas.
  username     String?

  emailVerified Boolean @default(false)
  /// La 2FA est exigée sur ce compte (distinct de « une clé TOTP existe »,
  /// voir `twoFactorEnabled` plus bas — Better Auth).
  isMfaEnabled  Boolean @default(false)

  /// Identifiant Google, présent uniquement pour les comptes OAuth.
  googleId String? @unique
  name     String?
  picture  String?

  /// Client Stripe créé au premier ajout d'une carte enregistrée
  /// (`savedPaymentsEnabled`) — jamais créé pour le paiement simple.
  stripeCustomerId String? @unique

  /// Consentement aux emails marketing (relances, retour en stock,
  /// nouveautés) — jamais les emails transactionnels (facture, confirmation
  /// de commande, réinitialisation de mot de passe), toujours envoyés.
  /// `false` par défaut : opt-in explicite, pas opt-out.
  marketingEmailsOptIn Boolean @default(false)

  role Role @default(CLIENT)

  /// Code de parrainage unique, généré à la création du compte
  /// (`generateUniqueReferralCode`) — jamais deviné, jamais réutilisé.
  referralCode String  @unique
  /// Compte parrain, posé une seule fois à l'inscription si `?ref=<code>`
  /// désignait un compte existant et que le module était actif à ce moment-là.
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  /// Filleuls parrainés par ce compte.
  referrals    User[]  @relation("Referrals")

  // Relations commerce
  addresses           Address[]
  orders              Order[]
  transactions        Transaction[]
  reviews             Review[]
  productQuestions    ProductQuestion[]
  wishlistItems       WishlistItem[]
  savedPaymentMethods SavedPaymentMethod[]
  returnRequests      ReturnRequest[]
  loyaltyAwards       LoyaltyAward[]
  referralRewards     ReferralReward[]
  stockAlerts         StockAlert[]
  productViews        ProductView[]

  // Relations d'authentification 100 % maison (jamais Lucia ni Better
  // Auth — code et verification par code, voir MIGRATION_BETTER_AUTH.md)
  emailVerificationRequests EmailVerificationRequest[] @relation("UserEmailVerificationRequests")
  passwordResetSessions     PasswordResetSession[]     @relation("UserPasswordResetSessions")
  loginEvents               LoginEvent[]

  // Better Auth — champs additionnels exigés par les plugins `admin` et
  // `twoFactor` (voir MIGRATION_BETTER_AUTH.md). `role`/`username`/
  // `referralCode`/`referredById`/`marketingEmailsOptIn` existent déjà
  // ci-dessus et sont réutilisés tels quels par le mapping Better Auth
  // (voir `additionalFields` dans `src/lib/auth/index.ts`), pas dupliqués ici.
  twoFactorEnabled Boolean?      @default(false)
  banned           Boolean?      @default(false)
  banReason        String?
  banExpires       DateTime?
  authSessions     AuthSession[]
  authAccounts     AuthAccount[]
  twoFactors       TwoFactor[]

  /// LINKMUSICIAN: personne associée au compte (voir la section LINKMUSICIAN en fin de fichier).
  person Person?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Better Auth — remplace le module Lucia (voir MIGRATION_BETTER_AUTH.md).
// Schéma généré par `npx @better-auth/cli generate` puis adapté : `User`
// réutilisée telle quelle (pas de modèle `user` dupliqué), noms de modèle
// explicites (`AuthSession`/`AuthAccount`/`AuthVerification` plutôt que les
// noms par défaut `session`/`account`/`verification`, pour ne jamais les
// confondre avec le `Session` Lucia encore présent pendant la transition).
// -----------------------------------------------------------------------------

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  /// Localisation approximative (en-têtes de géolocalisation Vercel),
  /// même principe que l'ancien `Session.city`/`.country` Lucia.
  city         String?
  country      String?
  lastActiveAt DateTime?

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id         String @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Argon2id, mêmes paramètres que l'ancien `User.passwordHash` Lucia —
  /// `null` pour un compte `providerId: "google"`.
  password String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

/// Scaffolding interne Better Auth (jetons de vérification email/reset —
/// non utilisé par nos parcours maison à base de code, voir
/// MIGRATION_BETTER_AUTH.md, mais requis par le schéma du plugin).
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model TwoFactor {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Secret TOTP, chiffré par Better Auth (`BETTER_AUTH_SECRET`) — jamais en clair.
  secret      String
  /// Tableau JSON de codes de secours, chiffré par Better Auth.
  backupCodes String

  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

/// Historique des connexions — distinct de `AuthSession` (Better Auth) :
/// survit à l'expiration ou à la révocation de la session qu'il documente
/// (jamais de clé étrangère
/// vers elle), pour qu'« il y a 2 mois, connexion depuis un iPhone à Lyon »
/// reste consultable bien après que cette session-là a disparu. Une ligne par
/// authentification réelle seulement — pas à chaque réémission de session
/// (validation 2FA, changement de mot de passe) : voir `recordLoginEvent`,
/// seul point d'écriture (`$lib/prisma/loginEvent/loginEvent.ts`).
model LoginEvent {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())
  /// Mêmes colonnes et même origine que `AuthSession.userAgent`/`ipAddress`/
  /// `city`/`country` — capturées une seule fois, jamais recalculées.
  userAgent   String?
  ipAddress   String?
  city        String?
  country     String?
  /// 'password' | 'google' | 'password-reset' — jamais 'signup' pour l'alerte
  /// (voir `isNewDevice`), toujours pour l'historique.
  method      String
  /// Vrai si `recordLoginEvent` n'a trouvé aucune connexion antérieure avec
  /// ce même `userAgent` pour ce compte — a déclenché l'e-mail « nouvelle
  /// connexion » (`$lib/server/newDeviceAlert.ts`), jamais recalculé après
  /// coup : ce champ documente ce qui a été décidé au moment de la
  /// connexion, pas un état dérivable a posteriori.
  isNewDevice Boolean  @default(false)

  @@index([userId, createdAt])
  @@map("login_events")
}

/// Jeton à usage unique porté par le lien « Ce n'était pas moi » de l'alerte
/// nouvel appareil (`$lib/server/newDeviceAlert.ts`) — permet de révoquer UNE
/// session précise sans être connecté. Jamais le `Session.id` lui-même dans
/// l'e-mail : c'est un identifiant porteur (équivalent au cookie de session),
/// le divulguer permettrait d'usurper la session, pas seulement de la
/// révoquer. `sessionId` n'est pas une clé étrangère vers `Session` : la
/// session peut déjà avoir expiré au moment où le jeton est utilisé, sans
/// que ce soit une erreur (`consumeSessionRevokeToken` traite l'absence de
/// session comme un succès silencieux — il n'y a de toute façon plus rien à
/// révoquer).
model SessionRevokeToken {
  /// Le jeton lui-même (`generateSecureToken`, même génération que `Session.id`).
  id        String   @id
  userId    String
  sessionId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("session_revoke_tokens")
}

/// Code à 8 caractères envoyé par email, à la création du compte comme au
/// changement d'adresse. Une seule requête vivante par utilisateur : la
/// précédente est supprimée avant d'en créer une nouvelle.
model EmailVerificationRequest {
  id        String   @id
  user      User     @relation("UserEmailVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Adresse à vérifier, qui peut différer de `user.email` lors d'un changement.
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_requests")
}

/// Réinitialisation de mot de passe en trois temps : code reçu par email, puis
/// 2FA si le compte l'exige, puis saisie du nouveau mot de passe. Les deux
/// drapeaux tracent la progression et interdisent de sauter une étape.
model PasswordResetSession {
  id                String   @id
  user              User     @relation("UserPasswordResetSessions", fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  email             String
  code              String
  expiresAt         DateTime
  emailVerified     Boolean  @default(false)
  twoFactorVerified Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_sessions")
}

// COMMERCE ______________________________________________________________________________

model Address {
  id                 String   @id @default(cuid())
  first_name         String
  last_name          String
  phone              String
  company            String?
  street_number      String
  street             String
  city               String
  county             String
  state              String
  stateLetter        String
  state_code         String
  zip                String
  country            String
  country_code       String
  ISO_3166_1_alpha_3 String
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Une adresse du carnet peut servir de livraison et/ou de facturation selon
  // la commande (choix fait au checkout, indépendamment l'une de l'autre).
  shippingOrders     Order[]  @relation("OrderShippingAddress")
  billingOrders      Order[]  @relation("OrderBillingAddress")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// COMMERCE-PLUGIN : commande PENDING (panier) puis PAID après webhook Stripe.
model Order {
  id                   String      @id @default(cuid())
  userId               String
  // Adresse de livraison (colis Sendcloud) et adresse de facturation
  // (facture PDF) : deux champs distincts depuis la séparation shipping/billing
  // — jusque là une seule adresse servait aux deux usages. Peuvent pointer
  // vers la même `Address` (cas « identique à l'adresse de livraison », le
  // défaut au checkout).
  shippingAddressId    String?
  billingAddressId     String?
  subtotal             Decimal     @default(0) @db.Decimal(10, 2)
  tax                  Decimal     @default(0) @db.Decimal(10, 2)
  total                Decimal     @default(0) @db.Decimal(10, 2)
  status               OrderStatus @default(PENDING)
  promoCode            String?
  discountAmount       Decimal     @default(0) @db.Decimal(10, 2)
  /// Carte cadeau appliquée : `giftCardAmount` est déjà inclus dans
  /// `discountAmount` ci-dessus (qui reste la remise totale utilisée par le
  /// calcul de facture) — ces deux champs ne servent qu'à l'affichage /
  /// l'audit du détail de la remise.
  giftCardCode         String?
  giftCardAmount       Decimal     @default(0) @db.Decimal(10, 2)
  /// Relance panier abandonné (`StoreSettings.cartRecoveryEnabled`,
  /// `$lib/server/jobs/cartRecovery.ts`) : horodatage de chaque email envoyé,
  /// pour ne jamais relancer deux fois le même palier sur la même commande.
  cartReminder1SentAt  DateTime?
  cartReminder2SentAt  DateTime?
  /// Relance avis produit post-livraison (`StoreSettings.reviewReminderEnabled`,
  /// `$lib/server/jobs/reviewReminder.ts`) : posé une seule fois, jamais
  /// réinitialisé — un seul rappel par commande, contrairement aux deux
  /// paliers de `cartReminder*SentAt` ci-dessus.
  reviewReminderSentAt DateTime?
  /// Détection de fraude (`StoreSettings.fraudDetectionEnabled`,
  /// `$lib/server/fraud.ts`) : posés par l'action `checkout` avant toute
  /// tentative de paiement, jamais recalculés ensuite. Recopiés sur
  /// `Transaction` au moment du webhook, même pattern que les adresses
  /// aplaties ci-dessous.
  riskScore            Int?
  riskLevel            String?
  riskFactors          String[]    @default([])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]

  shippingOption String?
  shippingCost   Decimal? @db.Decimal(10, 2)

  // Champs plats pour les informations du point relais
  servicePointId           String?
  servicePointPostNumber   String?
  servicePointLatitude     String?
  servicePointLongitude    String?
  servicePointType         String?
  servicePointExtraRefCab  String?
  servicePointExtraShopRef String?

  // Une commande est conservée si son utilisateur est supprimé : l'effacement
  // se fait par anonymisation, pas par suppression (obligation comptable).
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress Address?             @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?             @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  statusHistory   OrderStatusHistory[]
  transactions    Transaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  // `findPendingOrder`/`pendingOrderHandle` (hooks.server.ts) filtrent sur
  // les deux à chaque requête authentifiée — composite dédié plutôt que
  // deux index séparés.
  @@index([userId, status])
  // Sert la purge des paniers PENDING abandonnés ($lib/server/jobs/cleanup.ts) :
  // filtre status + updatedAt ensemble, pas juste chacun séparément.
  @@index([status, updatedAt])
  // Anticipe un listing de commandes filtré par statut et trié par date
  // (roadmap post-audit) : aucun `findMany` ne l'exploite encore aujourd'hui,
  // mais c'est le composite recommandé pour ce genre de requête paginée.
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  /// Variante sélectionnée, si le produit en propose (`ProductVariant`).
  /// `null` pour un produit sans variante — comportement inchangé.
  variantId String?
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  custom    Custom[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // PRODUCT-PLUGIN / COMMERCE-PLUGIN : Restrict — un produit déjà commandé ne
  // doit pas pouvoir détruire l'historique de vente. OrderItem.productId est
  // le couplage catalogue → tunnel.
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Même garde que `product` ci-dessus : une variante déjà commandée reste
  // supprimable seulement une fois son historique purgé (jamais en cascade).
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

/// Variante simple d'un produit (étiquette libre, pas d'axes combinatoires) :
/// stock propre, prix optionnel qui surcharge `Product.price` quand renseigné.
/// Gérée depuis `/admin/products/[id]/variants`, jamais depuis le formulaire
/// produit principal (délibérément séparé — ce formulaire est déjà chargé).
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  label     String
  sku       String?  @unique
  /// `null` = utilise `Product.price` tel quel.
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_histories")
}

model Product {
  // PRODUCT-PLUGIN : cœur du catalogue. Les OrderItem du commerce y font référence.
  id              String                 @id @default(cuid())
  name            String
  description     String
  price           Decimal                @db.Decimal(10, 2)
  stock           Int
  images          String[]
  slug            String                 @unique
  colorProduct    String
  /// Référence interne, distincte de `id` (cuid non lisible) — affichée en
  /// admin et sur la facture, jamais utilisée comme clé de recherche Prisma.
  sku             String?                @unique
  /// Prix barré affiché à côté de `price` quand renseigné (`price` reste le
  /// prix réellement facturé — pas de logique de remise appliquée ici).
  compareAtPrice  Decimal?               @db.Decimal(10, 2)
  /// Fin de vente flash : bandeau + compte à rebours vitrine tant que cette
  /// date est dans le futur. Se combine avec `compareAtPrice` pour le prix
  /// barré, mais fonctionne aussi seul (juste l'urgence du minuteur).
  flashSaleEndsAt DateTime?
  categories      ProductCategory[]
  orderItems      OrderItem[]
  reviews         Review[]
  questions       ProductQuestion[]
  wishlistedBy    WishlistItem[]
  stockAlerts     StockAlert[]
  views           ProductView[]
  /// Variantes simples (étiquette libre : « Taille 54 », « Or blanc »...),
  /// chacune avec son propre stock et un prix optionnel qui surcharge
  /// `price` ci-dessus. Un produit sans variante se comporte exactement
  /// comme avant leur introduction — jamais de variante implicite créée.
  variants        ProductVariant[]
  /// Facette catalogue « Matière » — taxonomie gérée depuis
  /// `/admin/products` (section Matières), pas un champ libre : évite que
  /// « Or »/« or »/« OR » cohabitent et cassent le filtre.
  /// Legacy : remplacé par `taxonomyValues` (voir `Taxonomy`), retiré en migration B
  /// une fois la bascule vérifiée.
  materialId      String?
  material        Material?              @relation(fields: [materialId], references: [id], onDelete: SetNull)
  /// Système générique de taxonomies (Matière, Catégorie, Couleur, ...) —
  /// remplace à terme `materialId`/`categories` ci-dessus.
  taxonomyValues  ProductTaxonomyValue[]
  /// Poids réel de l'unité en kg. `null` = pas encore renseigné par l'admin,
  /// `$lib/commerce/packageEstimate.ts` retombe alors sur une estimation par
  /// défaut (bijou standard) pour ne pas casser le calcul de colis Sendcloud
  /// tant que le catalogue n'est pas rempli.
  weight          Float?
  /// Dimensions unitaires en cm, mêmes règles de repli que `weight` ci-dessus.
  length          Float?
  width           Float?
  height          Float?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([materialId])
  @@map("products")
}

model Material {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("materials")
}

// PRODUCT-PLUGIN : système générique de taxonomies, remplace à terme `Material`
// et `Category`/`ProductCategory` ci-dessus (retrait prévu en migration B).
// `Taxonomy` = le type (« Matière », « Couleur »...), `TaxonomyValue` = ses
// valeurs possibles (avec hiérarchie optionnelle via `parentId`),
// `ProductTaxonomyValue` = l'assignation à un produit.
model Taxonomy {
  id         String          @id @default(cuid())
  name       String          @unique
  /// Utilisé comme nom de paramètre de filtre catalogue (`?<slug>=valeur`).
  slug       String          @unique
  type       TaxonomyType    @default(TEXT)
  /// true = plusieurs valeurs par produit (ex: Catégorie), false = une seule (ex: Matière).
  multiple   Boolean         @default(true)
  /// Bornes de validation à la saisie d'une valeur, utilisées seulement si `type = NUMBER`.
  numberMin  Float?
  numberMax  Float?
  numberUnit String?
  values     TaxonomyValue[]
  createdAt  DateTime        @default(now())

  @@map("taxonomies")
}

model TaxonomyValue {
  id         String   @id @default(cuid())
  taxonomyId String
  taxonomy   Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  /// Stockage brut interprété selon `taxonomy.type` : TEXT/COLOR -> texte libre,
  /// NUMBER -> parsable en Float, BOOLEAN -> "true"/"false", DATE -> ISO 8601.
  value       String
  /// Libellé affiché si différent de `value`.
  label       String?
  description String?
  image       String?
  /// Code additionnel selon le type (hex pour COLOR, ex: #FF0000).
  code        String?

  parentId String?
  parent   TaxonomyValue?  @relation("TaxonomyValueHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children TaxonomyValue[] @relation("TaxonomyValueHierarchy")

  products ProductTaxonomyValue[]

  @@unique([taxonomyId, value])
  @@index([parentId])
  @@map("taxonomy_values")
}

model ProductTaxonomyValue {
  id              String        @id @default(cuid())
  productId       String
  taxonomyValueId String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxonomyValue   TaxonomyValue @relation(fields: [taxonomyValueId], references: [id], onDelete: Cascade)

  @@unique([productId, taxonomyValueId])
  @@index([taxonomyValueId])
  @@map("product_taxonomy_values")
}

model Review {
  // PRODUCT-PLUGIN : un avis par compte et par produit (contrainte unique
  // plutôt qu'une limite applicative — vrai même sous requêtes concurrentes).
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

/// Question posée par un client sur une fiche produit, distincte des avis
/// (`Review`) : pas de note, réponse écrite par un admin avant publication —
/// une question non répondue reste invisible du public (pas de file
/// « en attente » affichée aux visiteurs). Activable/désactivable via
/// `StoreSettings.productQnaEnabled`.
model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  userId     String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_questions")
}

/// File d'attente « Me prévenir » : un compte s'inscrit sur un produit en
/// rupture (`Product.stock <= 0`) et reçoit un e-mail une seule fois dès
/// que le stock repasse au-dessus de 0. Contrainte unique par compte et par
/// produit — `notifiedAt` distingue une inscription encore en attente
/// (`null`) d'une déjà notifiée ; se réinscrire après notification remet
/// `notifiedAt` à `null` plutôt que de créer une seconde ligne. Complète le
/// module Questions produit (même patron : lié à un compte, jamais un
/// simple e-mail anonyme). Activable/désactivable via
/// `StoreSettings.stockAlertsEnabled`.
model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  userId     String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@map("stock_alerts")
}

model Custom {
  id          String    @id @default(cuid())
  image       String
  userMessage String
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderItemId])
  @@map("customizations")
}

// COMMERCE-PLUGIN : écriture permanente après paiement. Surface admin `/admin/sales`.
model Transaction {
  id              String  @id @default(cuid())
  stripePaymentId String  @unique
  /// Nullable : la transaction est l'écriture permanente, la commande est transitoire.
  orderId         String?
  userId          String?
  amount          Decimal @db.Decimal(10, 2)
  currency        String

  /// PaymentIntent Stripe de la session (`session.payment_intent`, déjà
  /// présent dans le payload `checkout.session.completed` sans appel API
  /// supplémentaire) — sert uniquement à rattacher un litige
  /// (`charge.dispute.*`, qui ne référence que ce PaymentIntent) sans devoir
  /// interroger Stripe depuis le webhook.
  stripePaymentIntentId String? @unique

  /// Litige Stripe (`charge.dispute.created`/`.closed`, webhook
  /// `/api/webhooks`) — jamais résolu automatiquement, juste tracé et
  /// alerté (`$lib/server/disputeAlert.ts`). `disputeId` sert de garde
  /// d'idempotence contre un retry du même évènement webhook.
  disputeId       String?   @unique
  disputeStatus   String?
  disputeReason   String?
  disputeAmount   Decimal?  @db.Decimal(10, 2)
  disputeOpenedAt DateTime?
  disputeClosedAt DateTime?

  customer_details_email String? @default("")
  customer_details_name  String? @default("")
  customer_details_phone String? @default("")

  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingOption String
  shippingCost   Decimal @db.Decimal(10, 2)

  // Informations sur le mode d'expédition
  shippingMethodId   Int
  shippingMethodName String

  // Informations supplémentaires Sendcloud
  sendcloudParcelId       Int?
  trackingNumber          String?
  trackingUrl             String?
  /// Posé après le premier succès de `createSendcloudOrder` (job post-paiement) :
  /// garde d'idempotence contre un retry QStash qui recréerait la commande.
  sendcloudOrderCreatedAt DateTime?

  /// Dernier statut transporteur reçu du webhook Sendcloud (`parcel.status`),
  /// affiché tel quel dans `OrderTrackingPanel` — jamais interprété côté code.
  shippingStatusCode      Int?
  shippingStatusMessage   String?
  shippingStatusUpdatedAt DateTime?

  // Dimensions et poids du colis selon l'API Sendcloud
  package_length         Float
  package_width          Float
  package_height         Float
  package_dimension_unit String
  package_weight         Float
  package_weight_unit    String
  package_volume         Float
  package_volume_unit    String

  // Adresse d'expédition figée au moment du paiement
  address_first_name         String
  address_last_name          String
  address_phone              String
  address_company            String?
  address_street_number      String
  address_street             String
  address_city               String
  address_county             String
  address_state              String
  address_stateLetter        String
  address_state_code         String
  address_zip                String
  address_country            String
  address_country_code       String
  address_ISO_3166_1_alpha_3 String

  // Adresse de facturation figée au moment du paiement (facture PDF) — peut
  // différer de l'adresse d'expédition ci-dessus depuis la séparation
  // shipping/billing du checkout.
  billing_first_name         String
  billing_last_name          String
  billing_phone              String
  billing_company            String?
  billing_street_number      String
  billing_street             String
  billing_city               String
  billing_county             String
  billing_state              String
  billing_stateLetter        String
  billing_state_code         String
  billing_zip                String
  billing_country            String
  billing_country_code       String
  billing_ISO_3166_1_alpha_3 String

  // Point relais
  servicePointId           String?
  servicePointPostNumber   String?
  servicePointLatitude     String?
  servicePointLongitude    String?
  servicePointType         String?
  servicePointExtraRefCab  String?
  servicePointExtraShopRef String?

  /// Détection de fraude — recopié depuis `Order` au moment du webhook, même
  /// pattern que les adresses aplaties ci-dessus (voir `Order.riskScore`).
  riskScore   Int?
  riskLevel   String?
  riskFactors String[] @default([])

  /// Instantané des produits commandés (jsonb).
  products Json

  /// Instantané fiscal figé au paiement (lot 2).
  invoiceNumber  String? @unique
  subtotalHt     Decimal @default(0) @db.Decimal(10, 2)
  taxRate        Float   @default(5.5)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  promoCode      String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  returnRequest ReturnRequest?

  @@index([status])
  // Sert `/auth/settings/factures` (getTransactionsByUserId.ts) : filtre
  // userId + tri createdAt ensemble, pas juste chacun séparément.
  @@index([userId, createdAt])
  @@map("transactions")
}

/// Compteur annuel des numéros FAC-AAAA-n.
model InvoiceCounter {
  year Int @id
  last Int

  @@map("invoice_counters")
}

/// Compteur annuel des numéros d'avoir AV-AAAA-n (`ReturnRequest.creditNoteNumber`),
/// séquence indépendante de `InvoiceCounter` — un avoir n'est pas une facture.
model CreditNoteCounter {
  year Int @id
  last Int

  @@map("credit_note_counters")
}

/// Traçabilité de l'export comptable mensuel envoyé
/// (`$lib/server/jobs/accountingExport.ts`) — un enregistrement par période
/// (`YYYY-MM`) empêche un double envoi si le job est rejoué (retry QStash,
/// relance manuelle) : contrairement au verrou Redis (`withLock`, éphémère
/// et absent en dev/e2e sans Upstash), cet enregistrement persiste.
model AccountingExportLog {
  period           String   @id
  sentAt           DateTime @default(now())
  transactionCount Int

  @@map("accounting_export_logs")
}

model ProductCategory {
  id         String @id @default(cuid())
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  products  ProductCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("categories")
}

// PROMO-PLUGIN : remises checkout. Hors COMMERCE (Order.promoCode reste une colonne du tunnel).
model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  type             PromoType
  value            Decimal   @db.Decimal(10, 2)
  minAmount        Decimal?  @db.Decimal(10, 2)
  usageLimit       Int?
  usageCount       Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true)
  /// Si renseigné, ce code est une récompense de fidélité : accordé
  /// automatiquement quand un compte atteint ce nombre de commandes payées
  /// (`StoreSettings.loyaltyEnabled`), voir `LoyaltyAward`. Rien à voir avec
  /// `usageLimit`/`expiresAt` ci-dessus qui restent des garde-fous normaux.
  loyaltyThreshold Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  loyaltyAwards LoyaltyAward[]

  @@index([active])
  @@map("promo_codes")
}

/// Trace qu'un compte a déjà reçu la récompense de fidélité d'un code donné —
/// évite un double envoi si le webhook Stripe est retenté (seuil de commandes
/// payées atteint une seule fois, mais l'événement peut être livré 2x).
model LoyaltyAward {
  id                String   @id @default(cuid())
  userId            String
  promoCodeId       String
  orderCountAtAward Int
  createdAt         DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@map("loyalty_awards")
}

// BLOG-PLUGIN ____________________________________________________________________________

model BlogPost {
  id             String                  @id @default(cuid())
  title          String
  content        String
  slug           String                  @unique
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  published      Boolean                 @default(false)
  author         BlogAuthor              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId       String
  category       BlogCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  comments       BlogComment[]
  tags           BlogPostTag[]
  /// Remplace à terme `category`/`tags` ci-dessus (migration en cours, voir BlogTaxonomy).
  taxonomyValues BlogPostTaxonomyValue[]

  @@index([authorId])
  @@index([categoryId])
  @@index([published, createdAt])
  @@map("blog_posts")
}

model BlogAuthor {
  id        String     @id @default(cuid())
  name      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())

  @@map("blog_authors")
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())

  @@map("blog_categories")
}

model BlogComment {
  id        String   @id @default(cuid())
  content   String
  author    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("blog_comments")
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())

  @@map("blog_tags")
}

model BlogPostTag {
  id     String   @id @default(cuid())
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@unique([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

// BLOG-PLUGIN : système générique de taxonomies (remplace à terme `BlogCategory`
// et `BlogTag`/`BlogPostTag` ci-dessus). Tables dédiées au blog (pas de
// dépendance vers `Taxonomy`/`TaxonomyValue` PRODUCT-PLUGIN) pour garder le
// blog retirable indépendamment du catalogue produit.
model BlogTaxonomy {
  id        String              @id @default(cuid())
  name      String              @unique
  /// Utilisé comme nom de paramètre de filtre vitrine (`?<slug>=valeur`).
  slug      String              @unique
  /// true = plusieurs valeurs par article (ex: Tag), false = une seule (ex: Catégorie).
  multiple  Boolean             @default(true)
  values    BlogTaxonomyValue[]
  createdAt DateTime            @default(now())

  @@map("blog_taxonomies")
}

model BlogTaxonomyValue {
  id         String                  @id @default(cuid())
  taxonomyId String
  taxonomy   BlogTaxonomy            @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  value      String
  /// Libellé affiché si différent de `value`.
  label      String?
  posts      BlogPostTaxonomyValue[]
  createdAt  DateTime                @default(now())

  @@unique([taxonomyId, value])
  @@map("blog_taxonomy_values")
}

model BlogPostTaxonomyValue {
  id              String            @id @default(cuid())
  postId          String
  taxonomyValueId String
  post            BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  taxonomyValue   BlogTaxonomyValue @relation(fields: [taxonomyValueId], references: [id], onDelete: Cascade)

  @@unique([postId, taxonomyValueId])
  @@index([taxonomyValueId])
  @@map("blog_post_taxonomy_values")
}

// CONTACT-PLUGIN : messages du formulaire public `/contact`.
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("contact_submissions")
}

/// Trace des actions admin sensibles (suppression de compte, changement de
/// rôle). Pas de relation FK vers `User` sur `actorId`/`targetId` : le journal
/// doit rester lisible même après suppression de l'un des deux comptes.
/// Interrupteurs des modules e-commerce optionnels (roadmap post-audit) —
/// ligne unique (`id = "singleton"`), gérée depuis `/admin/settings`. Un
/// module désactivé n'apparaît nulle part côté vitrine, il n'est pas juste
/// masqué visuellement : chaque route publique concernée vérifie le flag
/// avant de lire/écrire ses propres données.
model StoreSettings {
  id                              String   @id @default("singleton")
  wishlistEnabled                 Boolean  @default(false)
  crossSellEnabled                Boolean  @default(false)
  returnsEnabled                  Boolean  @default(false)
  savedPaymentsEnabled            Boolean  @default(false)
  loyaltyEnabled                  Boolean  @default(false)
  giftCardsEnabled                Boolean  @default(false)
  productQnaEnabled               Boolean  @default(false)
  cartRecoveryEnabled             Boolean  @default(false)
  flashSaleEnabled                Boolean  @default(false)
  referralEnabled                 Boolean  @default(false)
  stockAlertsEnabled              Boolean  @default(false)
  /// Bundle « Souvent achetés ensemble » (`$lib/prisma/bundles/bundles.ts`) :
  /// suggestion panier + petite remise automatique, basées sur la
  /// co-occurrence réelle dans `OrderItem` — pas de table dédiée.
  frequentlyBoughtTogetherEnabled Boolean  @default(false)
  reviewReminderEnabled           Boolean  @default(false)
  /// Alerte wishlist (baisse de prix / vente flash), voir
  /// `$lib/server/jobs/wishlistPriceAlert.ts` — converge `wishlistEnabled` et
  /// `flashSaleEnabled` sans dépendre directement de ces deux flags.
  wishlistPriceAlertEnabled       Boolean  @default(false)
  /// Calcule un score de risque à chaque tentative de checkout
  /// (`$lib/server/fraud.ts`) et le pose sur `Order`/`Transaction`. Affiché
  /// dans `/admin/sales`, indépendant du blocage ci-dessous.
  fraudDetectionEnabled           Boolean  @default(false)
  /// N'a d'effet que si `fraudDetectionEnabled` est aussi actif (vérifié
  /// dans le code, pas seulement documenté) : bloque la commande (jamais de
  /// session Stripe créée) quand le score atteint le niveau `high`.
  fraudBlockingEnabled            Boolean  @default(false)
  /// Relance e-mail (digest, `$lib/server/jobs/recentlyViewedReminder.ts`)
  /// pour un produit consulté (`ProductView`) puis jamais acheté — comptes
  /// connectés uniquement, aucun suivi de visiteur anonyme dans ce projet.
  recentlyViewedReminderEnabled   Boolean  @default(false)
  /// Taux de TVA appliqué au catalogue (fraction, ex. 0.20 = 20 %), lu par
  /// `$lib/server/vat.ts` — remplace l'ancienne constante `TVA_RATE` figée
  /// à 5,5 % dans le code (taux réduit, incorrect pour de la bijouterie qui
  /// relève du taux normal en France). Valeur de défaut = l'ancienne
  /// constante, pour ne rien changer silencieusement en production tant que
  /// l'admin n'a pas lui-même ajusté le taux depuis `/admin/settings`.
  vatRate                         Float    @default(0.055)
  /// Délai de livraison estimé (jours ouvrés) affiché au client avant
  /// validation de commande (Code conso. art. L216-1) — `null` = rien
  /// affiché (comportement inchangé tant que l'admin n'a pas saisi une
  /// vraie estimation depuis `/admin/settings`, aucune date inventée).
  estimatedDeliveryMinDays        Int?
  estimatedDeliveryMaxDays        Int?
  /// Identité de l'entreprise (`$lib/server/companyIdentity.ts`), saisie
  /// depuis `/admin/identite` — remplace les `[À COMPLÉTER]` de
  /// `/mentions-legales` et les variables d'environnement `INVOICE_COMPANY_*`
  /// (`$lib/server/invoice/company.ts`, conservées comme repli si non
  /// saisi ici). `null` partout par défaut : personne ne peut deviner ces
  /// informations à la place de l'entreprise.
  companyName                     String?
  companyLegalForm                String?
  companyShareCapital             String?
  companyAddress                  String?
  companyCity                     String?
  companySiret                    String?
  companyVatNumber                String?
  companyPublicationDirector      String?
  companyPhone                    String?
  companyEmail                    String?
  /// URL Cloudinary du logo (upload direct depuis `/admin/identite`, même
  /// mécanisme que les images produit). Utilisé pour le JSON-LD
  /// `Organization` (`SEO.svelte`) et l'en-tête des factures/avoirs PDF —
  /// jamais de logo par défaut inventé si non fourni.
  companyLogoUrl                  String?
  updatedAt                       DateTime @updatedAt

  @@map("store_settings")
}

/// Trace d'une tentative de commande bloquée par la détection de fraude
/// (`StoreSettings.fraudBlockingEnabled`, `$lib/server/fraud.ts`) — sans
/// cette table, une commande bloquée n'a ni `Order` payée ni `Transaction`,
/// donc rien ne la rend visible dans `/admin/sales` : `/admin/fraud` lit
/// cette table pour permettre au support de retrouver un client bloqué à
/// tort. Pas de FK vers `User`/`Order` : trace permanente, ne doit jamais
/// disparaître si le compte ou la commande est supprimé ensuite (même
/// raison que `Transaction.userId`/`orderId`, tous deux nullable).
model FraudBlock {
  id          String   @id @default(cuid())
  userId      String
  orderId     String
  email       String
  riskScore   Int
  riskLevel   String
  riskFactors String[]
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("fraud_blocks")
}

/// Consultation d'une fiche produit par un compte connecté — sert
/// uniquement à la relance e-mail (`StoreSettings.recentlyViewedReminderEnabled`,
/// `$lib/server/jobs/recentlyViewedReminder.ts`). Sans rapport avec l'historique
/// vitrine « Récemment consultés » (`$lib/store/recentlyViewed.ts`), qui reste
/// 100 % `localStorage` et fonctionne aussi pour un visiteur anonyme — ce
/// modèle ne couvre que les visiteurs connectés, seuls identifiables par
/// e-mail pour une relance. Une seule ligne par (compte, produit) : une
/// revisite met juste à jour `viewedAt`, ne réinitialise jamais
/// `reminderSentAt` une fois posé (même logique que
/// `Order.reviewReminderSentAt` : un seul rappel, jamais réinitialisé).
model ProductView {
  id             String    @id @default(cuid())
  userId         String
  productId      String
  viewedAt       DateTime  @default(now())
  reminderSentAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([reminderSentAt, viewedAt])
  @@map("product_views")
}

/// Récompense de parrainage — une seule ligne par filleul (`referredId`),
/// posée à sa toute première commande payée, jamais aux suivantes. Le lien
/// vers la carte cadeau (`giftCardId`) n'est qu'un texte, comme `PromoCode`
/// sur `Order` : pas de FK vers `GiftCard`, la carte reste consultable et
/// gérable indépendamment depuis /admin/gift-cards. Activable/désactivable
/// via `StoreSettings.referralEnabled`.
model ReferralReward {
  id         String   @id @default(cuid())
  referrerId String
  /// Un seul filleul ne peut déclencher qu'une seule récompense.
  referredId String   @unique
  giftCardId String
  createdAt  DateTime @default(now())

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral_rewards")
}

/// Carte cadeau à solde décroissant. Pas de relation FK vers `Order` — même
/// choix que `PromoCode` (référencée par son `code`, en texte, sur la
/// commande) : la carte reste consultable/désactivable indépendamment de
/// l'historique des commandes qui l'ont utilisée.
/// Activable/désactivable via `StoreSettings.giftCardsEnabled`.
model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  initialValue   Decimal   @db.Decimal(10, 2)
  /// Solde restant, décrémenté à chaque utilisation en caisse (voir
  /// PROMO-PLUGIN : même moment que `PromoCode.usageCount`, c'est-à-dire dans
  /// le webhook Stripe après confirmation du paiement, pas à la création de
  /// la session — un panier Stripe abandonné ne consomme donc pas le solde).
  balance        Decimal   @db.Decimal(10, 2)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  recipientEmail String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active])
  @@map("gift_cards")
}

/// Liste d'envies — un produit par compte au plus une fois (contrainte
/// unique). Activable/désactivable via `StoreSettings.wishlistEnabled`.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  /// Prix du produit au moment de l'ajout (ou de la dernière alerte envoyée)
  /// — baseline comparée à `Product.price` par
  /// `$lib/server/jobs/wishlistPriceAlert.ts` : une nouvelle alerte n'est
  /// envoyée que si le prix courant repasse strictement sous cette valeur,
  /// jamais deux fois pour la même baisse.
  lastNotifiedPrice           Decimal?  @db.Decimal(10, 2)
  /// Même principe pour la vente flash en cours : une nouvelle date (nouvelle
  /// vente flash) redéclenche une alerte, la même jamais deux fois.
  lastNotifiedFlashSaleEndsAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  /// `productId` seul n'est pas couvert par l'unique (userId, productId) —
  /// nécessaire pour `listWishlistItemsForProduct` (scan à chaque
  /// changement de prix/vente flash d'un produit).
  @@index([productId])
  @@map("wishlist_items")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Carte enregistrée (`StoreSettings.savedPaymentsEnabled`) — jamais de PAN/CVC
/// stocké ici, uniquement les métadonnées d'affichage. La source de vérité
/// (carte utilisable) reste le `PaymentMethod` Stripe, attaché au
/// `User.stripeCustomerId`.
model SavedPaymentMethod {
  id                    String   @id @default(cuid())
  userId                String
  stripePaymentMethodId String   @unique
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_payment_methods")
}

/// Demande de retour (`StoreSettings.returnsEnabled`) sur une transaction déjà
/// payée. `stripeRefundId` posé une fois le remboursement Stripe confirmé par
/// l'admin (`?/approve`) — jamais avant, `?/reject` n'en crée pas.
model ReturnRequest {
  id                   String       @id @default(cuid())
  transactionId        String
  userId               String
  reason               String
  /// Rétractation légale (14 jours, sans motif) ou retour SAV/garantie —
  /// voir `ReturnKind`. `WARRANTY` par défaut : les demandes créées avant
  /// l'introduction de ce champ restent lisibles comme des retours SAV.
  kind                 ReturnKind   @default(WARRANTY)
  status               ReturnStatus @default(REQUESTED)
  stripeRefundId       String?
  /// Posé à la place de `stripeRefundId` quand l'admin choisit de créditer le
  /// compte (`?/creditStore`, status CREDITED) plutôt que de rembourser via
  /// Stripe. Pas de relation formelle vers `GiftCard` — même découplage par
  /// id/code en texte que `PromoCode`/`GiftCard` ailleurs dans le schéma.
  giftCardId           String?
  /// Étiquette de retour Sendcloud — posée à l'approbation, best-effort : un
  /// échec Sendcloud ne bloque jamais le remboursement (voir la route admin).
  returnTrackingNumber String?
  returnTrackingUrl    String?
  /// Numéro d'avoir (AV-AAAA-00001, `$lib/server/creditNote/number.ts`), posé
  /// dans la même transaction DB que le passage REFUNDED/CREDITED — jamais
  /// régénéré (le statut ne peut plus repasser par REQUESTED).
  creditNoteNumber     String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

// ═══ LINKMUSICIAN ═════════════════════════════════════════════════════════════
// Modèles propres à LinkMusician, regroupés ici pour que les synchros avec le
// boilerplate (`git merge boilerplate/main`) ne touchent jamais cette section.
// Conception : docs/conception/04-modele-donnees.md.

/// Nature d'un acteur : une personne ou une structure (groupe, studio, label…).
enum ActorKind {
  PERSON
  ORGANIZATION
}

/// Métiers (« pistes ») d'une personne. Plusieurs par personne (décision D14).
/// Au lancement, seul MUSICIAN a un profil complet (décision D15).
enum TrackKind {
  MUSICIAN
  PRODUCER
  SOUND_ENGINEER
  MANAGER
  BOOKER
  PROMOTER
  LABEL_PRO
  PUBLISHER
  MUSIC_COMMS
}

/// Supertype de tout profil (personne ou structure) : la progression, les
/// médias, la localisation et les collaborations pointent tous sur `Actor`.
model Actor {
  id          String    @id @default(cuid())
  kind        ActorKind
  /// Identifiant public (`@handle`), unique, en minuscules : voir `src/lib/server/actors/handle.ts`.
  handle      String    @unique
  displayName String
  /// Présentation libre, texte brut (D18), 600 caractères au plus.
  bio         String?
  /// Palier de confiance 0 à 3 (conception 02 §7), recalculé par le moteur de
  /// progression, rétrogradable. Jamais calculé à partir de l'XP.
  trustLevel        Int       @default(0)
  trustComputedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Anonymisation RGPD : l'acteur reste pour l'historique de ses contreparties.
  deletedAt   DateTime?
  /// Profil public masqué par la personne (`/reglages`, D19) : `/@handle`
  /// renvoie une 404 et le profil sort du sitemap.
  hidden      Boolean   @default(false)

  person     Person?
  genres     ActorGenre[]
  influences Influence[]
  location   ActorLocation?
  media          Media[]
  reportsFiled    Report[]   @relation("ReportReporter")
  reportsReceived Report[]   @relation("ReportTargetActor")
  sanctions       Sanction[]
  xpTransactions XpTransaction[]
  progress       ActorProgress[]
  achievements   ActorAchievement[]
  activityDays   ActorActivityDay[]
  conversationParticipants ConversationParticipant[]
  conversationsInitiated Conversation[] @relation("ConversationInitiator")
  messagesSent         Message[]
  blocksMade           Block[]   @relation("BlocksMade")
  blocksReceived       Block[]   @relation("BlocksReceived")
  opportunities        Opportunity[]
  applications         Application[]
  collaborationsProposed Collaboration[] @relation("CollaborationProposer")
  collaborations         CollaborationParticipant[]
  availability           Availability?
  venuesCreated          Venue[]                @relation("VenueCreator")
  venuesClaimed          Venue[]                @relation("VenueClaimer")
  jamAttendances         JamAttendance[]
  venuesConfirmed        Venue[]                @relation("VenueConfirmer")
  jamsLed                Opportunity[]          @relation("JamLead")
  jamInvites             JamInvite[]
  endorsementsGiven      JamEndorsement[]       @relation("EndorsementFrom")
  endorsementsReceived   JamEndorsement[]       @relation("EndorsementTo")
  networkTies            MusicalTie[]           @relation("TieOwner")
  networkOf              MusicalTie[]           @relation("TieContact")
  collabEndorsementsGiven    CollabEndorsement[] @relation("CollabEndorsementFrom")
  collabEndorsementsReceived CollabEndorsement[] @relation("CollabEndorsementTo")
  reputation                 ReputationSnapshot?
  notifications              Notification[]           @relation("NotificationRecipient")
  notificationsCaused        Notification[]           @relation("NotificationFrom")
  notificationPreferences    NotificationPreference[]
  suggestionsDismissed       SuggestionDismissal[]    @relation("SuggestionOwner")
  dismissedAsSuggestion      SuggestionDismissal[]    @relation("SuggestionTarget")
  organization               Organization?
  memberships                Membership[]             @relation("MembershipPerson")
  membershipInvitesSent      Membership[]             @relation("MembershipInviter")
  opportunitiesPosted        Opportunity[]            @relation("OpportunityPoster")
  works                      Work[]                   @relation("WorkOwner")
  worksCreated               Work[]                   @relation("WorkCreator")
  workCredits                WorkContributor[]        @relation("WorkContributorPerson")
  workCreditsInvited         WorkContributor[]        @relation("WorkContributorInviter")
  milestones                 Milestone[]              @relation("MilestoneBand")
  milestonesDeclared         Milestone[]              @relation("MilestoneDeclarer")
  milestoneAttestations      MilestoneAttestation[]   @relation("MilestoneAttester")
  milestoneAttestationsAsked MilestoneAttestation[]   @relation("MilestoneAttestationRequester")
  milestoneEvidenceAdded     MilestoneEvidence[]      @relation("MilestoneEvidenceAdder")
  contactGroups              ContactGroup[]           @relation("ContactGroupOwner")
  contactGroupMemberships    ContactGroupMember[]     @relation("ContactGroupContact")
  groupDiscussionsCreated    GroupDiscussion[]        @relation("GroupDiscussionCreator")
  groupDiscussionSeats       GroupDiscussionMember[]  @relation("GroupDiscussionMemberActor")
  groupDiscussionMessages    GroupDiscussionMessage[] @relation("GroupDiscussionMessageSender")
  orgVerificationsRequested  OrganizationVerification[] @relation("OrgVerificationRequester")

  @@map("actors")
}

/// Une personne = un compte (`User`). Créée à l'inscription, ou à l'écran
/// `/bienvenue` pour les comptes qui n'en ont pas encore (Google, comptes
/// existants).
model Person {
  actorId         String    @id
  actor           Actor     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Jamais affichée : sert uniquement au contrôle d'âge (16 ans minimum, D5).
  /// `null` après anonymisation.
  birthDate       DateTime? @db.Date
  /// Acceptation des CGU (preuve de consentement).
  termsAcceptedAt DateTime
  createdAt       DateTime  @default(now())

  tracks      PersonTrack[]
  instruments PersonInstrument[]

  /// Fin de l'onboarding (P1-10). Seul repère stocké : l'étape courante se
  /// déduit du profil (métiers, instruments, genres, ville), mais « juste
  /// explorer » ne laisse aucune trace dans le profil.
  onboardedAt    DateTime?
  /// Célébrations (P2-11) : gains et événements de progression déjà
  /// montrés jusqu'à cette date. `null` : depuis l'inscription.
  celebrationsSeenAt DateTime?
  /// Dernier mode de jeu choisi à l'accueil (P2-12, D21).
  preferredMode      PlayMode?
  /// Modes dont la présentation pas à pas a été vue (P2-12b).
  modeIntrosSeen     PlayMode[]       @default([])
  /// Ambition du mode carrière (P3-12, conception 07 §4.1) : met en avant des
  /// objectifs, modifiable, jamais d'échec. `null` : pas encore choisie.
  ambition           CareerAmbition?
  /// Épreuves de la carte de carrière déjà fêtées (P3-13) : une célébration
  /// par acte franchi, une seule fois.
  actsCelebrated     Int[]            @default([])
  /// Dernier digest email (P2-09b) : au plus un par jour.
  digestSentAt       DateTime?
  /// Conseils en contexte masqués (« J'ai compris », P2-17) : identifiants du
  /// catalogue `#lib/guide/tips`. Un conseil masqué ne revient pas.
  tipsDismissed      String[]         @default([])

  /// Profil complet (D17, D18). Tout est déclaré, rien n'est vérifié.
  proStatus      ProStatus?
  lookingFor     LookingFor[]
  equipment      Equipment[]
  /// Année de début de pratique, affichée en années de pratique.
  practiceSince  Int?
  /// Rayon de déplacement accepté, par tranches (10, 25, 50, 100 km).
  travelRadiusKm Int?
  /// « Prêt·e à organiser des jams » (D51) : seul·es ces adultes lancent une
  /// jam ; profils proposés plus tard aux lieux et organisateurs.
  organizesJams  Boolean          @default(false)
  links          ProfileLink[]
  /// Métiers du son (P4-02).
  soundProfile    SoundEngineerProfile?
  craftReferences CraftReference[]
  /// Producteur·rice (P4-04).
  producerProfile ProducerProfile?

  @@map("persons")
}

/// Métier d'une personne. Un seul métier principal par personne.
model PersonTrack {
  personId  String
  person    Person    @relation(fields: [personId], references: [actorId], onDelete: Cascade)
  track     TrackKind
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@id([personId, track])
  @@map("person_tracks")
}

// ─── COMPÉTENCES : référentiels (P1-04) ─────────────────────────────────────
//
// Chargés par `npm run seed:referentiels` depuis `prisma/seed-data/` (rejouable,
// clé = `slug`). Une entrée retirée de la liste est désactivée (`active`),
// jamais supprimée : des profils peuvent y faire référence.

/// Famille d'instruments. Libellés dans `src/lib/skills/instruments.ts`.
enum InstrumentFamily {
  VOICE
  PLUCKED_STRINGS
  BOWED_STRINGS
  KEYBOARDS
  DRUMS_PERCUSSION
  BRASS
  WOODWINDS
  ELECTRONIC
  WORLD
}

/// Instrument (voix incluse).
model Instrument {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  family    InstrumentFamily
  sortOrder Int
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  players PersonInstrument[]
  media   Media[]
  opportunities Opportunity[]
  jamSpots      JamSpot[]
  jamAttendances JamAttendance[]
  jamInvites     JamInvite[]
  workRoles      WorkRole[]
  jamEndorsements JamEndorsement[]
  collabEndorsements CollabEndorsement[]

  @@index([family, sortOrder])
  @@map("instruments")
}

/// Genre musical, sur deux niveaux (D12) : un genre parent (Rock) et ses
/// sous-genres (Punk). Un sous-genre n'a jamais d'enfant.
model Genre {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  parentId  String?
  parent    Genre?   @relation("GenreTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Genre[]  @relation("GenreTree")
  actors    ActorGenre[]
  works     WorkGenre[]
  producers ProducerGenre[]
  sortOrder Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@map("genres")
}

// ─── COMPÉTENCES : profil musical (P1-06) ───────────────────────────────────

/// Instrument joué par une personne, avec son niveau déclaré (D11, 1 à 5).
/// De 1 à 5 instruments, dont exactement un principal : règle tenue par
/// `saveMusicalProfile` (`src/lib/prisma/skills/musicalProfile.ts`).
model PersonInstrument {
  personId      String
  person        Person     @relation(fields: [personId], references: [actorId], onDelete: Cascade)
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  declaredLevel Int
  isPrimary     Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@id([personId, instrumentId])
  @@index([instrumentId])
  @@map("person_instruments")
}

/// Genre pratiqué par un acteur (personne aujourd'hui, groupe plus tard).
model ActorGenre {
  actorId   String
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  genreId   String
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([actorId, genreId])
  @@index([genreId])
  @@map("actor_genres")
}

/// Influence déclarée en texte libre (artiste, album, courant), texte brut.
model Influence {
  id        String @id @default(cuid())
  actorId   String
  actor     Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int

  @@index([actorId, sortOrder])
  @@map("influences")
}

// ─── PROFIL COMPLET (P1-06b, D17, D18) ─────────────────────────────────────
// Libellés et règles : `src/lib/actors/profile.ts`.

/// Statut professionnel déclaré (D17).
enum ProStatus {
  AMATEUR
  SEMI_PRO
  PROFESSIONAL
}

/// « Ce que je recherche » (D18).
enum LookingFor {
  BAND
  REPLACEMENTS
  JAMS
  STUDIO_SESSIONS
  LESSONS_GIVE
  LESSONS_TAKE
  COLLABORATION
}

/// Matériel à disposition (D18).
enum Equipment {
  PA_SYSTEM
  REHEARSAL_SPACE
  VEHICLE
  HOME_STUDIO
}

/// Type de lien externe (D18). Domaine contrôlé selon le type.
enum LinkKind {
  SPOTIFY
  YOUTUBE
  BANDCAMP
  SOUNDCLOUD
  INSTAGRAM
  WEBSITE
}

/// Lien externe d'une personne, un par type, https uniquement.
model ProfileLink {
  personId  String
  person    Person   @relation(fields: [personId], references: [actorId], onDelete: Cascade)
  kind      LinkKind
  url       String
  createdAt DateTime @default(now())

  @@id([personId, kind])
  @@map("profile_links")
}

// ─── LOCALISATION FLOUTÉE (P1-05) ───────────────────────────────────────────
//
// Invariant : aucune localisation précise. On ne stocke que le centre de la
// commune, aligné sur une grille d'environ 2 km (`src/lib/geo/fuzz.ts`). Seul
// `src/lib/server/geo/queries.ts` lit ou écrit `point` (SQL brut, PostGIS).

/// Commune d'un acteur et son point flouté.
model ActorLocation {
  actorId        String                                @id
  actor          Actor                                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  /// Code INSEE de la commune.
  communeCode    String
  communeName    String
  departmentCode String
  /// Centre de la commune aligné sur une grille de ~2 km (jamais une position précise).
  point          Unsupported("geography(Point,4326)")
  updatedAt      DateTime                              @updatedAt

  @@index([point], type: Gist)
  @@map("actor_locations")
}

// ─── PROGRESSION (P1-07) ────────────────────────────────────────────────────
//
// Voir conception 03 §2.4. Le client n'écrit jamais ici : les services émettent
// des événements, le processeur applique les règles pures
// (`src/lib/server/progression/core`) et inscrit les gains.

/// Événement de domaine (outbox), en ajout seul. `processedAt` : traité par
/// le moteur de progression.
model DomainEvent {
  id          String          @id @default(cuid())
  type        String
  payload     Json
  /// Acteurs concernés (recherche des faits passés : collaborations…).
  actorIds    String[]
  occurredAt  DateTime        @default(now())
  processedAt DateTime?
  createdAt   DateTime        @default(now())
  xp          XpTransaction[]

  @@index([processedAt])
  @@index([type, occurredAt])
  @@map("domain_events")
}

/// Registre de l'XP, en AJOUT SEUL : jamais d'UPDATE ni de DELETE. Une
/// correction est une transaction négative liée (`reversesId`).
model XpTransaction {
  id            String          @id @default(cuid())
  actorId       String
  /// Suppression en cascade : seulement quand l'acteur lui-même est supprimé
  /// (jeux de test). Un compte anonymisé garde son acteur et son registre.
  actor         Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  /// "MUSICIAN" | "BAND" | … (piste de métier).
  track         String
  /// Négatif pour une annulation.
  amount        Int
  sourceEventId String
  sourceEvent   DomainEvent     @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  ruleId        String
  ruleVersion   Int
  multiplier    Decimal         @db.Decimal(4, 3)
  /// Lisible par la personne : « Collaboration confirmée ×0,5 ».
  reason        String
  reversesId    String?         @unique
  reverses      XpTransaction?  @relation("XpReversal", fields: [reversesId], references: [id], onDelete: Cascade)
  reversedBy    XpTransaction?  @relation("XpReversal")
  createdAt     DateTime        @default(now())

  /// Idempotence : un même événement ne crédite jamais deux fois.
  @@unique([sourceEventId, ruleId, actorId, track])
  @@index([actorId, createdAt])
  @@index([actorId, ruleId, createdAt])
  @@map("xp_transactions")
}

/// Projection de l'XP par acteur et par piste, RECONSTRUCTIBLE à tout moment
/// depuis le registre (`npm run progression:rebuild`). La piste "ACCOUNT"
/// porte le niveau de compte (somme des pistes d'une personne).
model ActorProgress {
  actorId   String
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  track     String
  xp        Int
  level     Int
  /// Palier nommé de la piste. Pas encore projeté : il se calcule à la lecture
  /// depuis les événements (`getMusicianTier`, P1-11).
  tier      String?
  updatedAt DateTime @updatedAt

  @@id([actorId, track])
  @@map("actor_progress")
}

/// Succès débloqué. Définitions dans `progression/core/achievements.ts`.
model ActorAchievement {
  actorId       String
  actor         Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  achievementId String
  sourceEventId String
  unlockedAt    DateTime @default(now())

  @@id([actorId, achievementId])
  @@map("actor_achievements")
}

// ─── MÉDIAS (P1-08) ─────────────────────────────────────────────────────────
// Règles pures : `src/lib/media/`. Un média n'est visible publiquement que
// `PUBLISHED`. Fichiers chez Cloudinary (dossier de l'acteur), liens externes
// affichés par lecteur intégré construit côté serveur (jamais le HTML oEmbed).

enum MediaKind {
  AUDIO
  VIDEO
  IMAGE
  EXTERNAL_LINK
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum MediaProvider {
  CLOUDINARY
  YOUTUBE
  SOUNDCLOUD
  BANDCAMP
}

model Media {
  id               String         @id @default(cuid())
  actorId          String
  actor            Actor          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  kind             MediaKind
  status           MediaStatus
  provider         MediaProvider
  /// public_id Cloudinary (fichiers envoyés).
  providerId       String?
  /// Adresse de diffusion du fichier (https, renvoyée par Cloudinary).
  fileUrl          String?
  /// Format du fichier (mp3, mp4, jpg…), relu chez Cloudinary.
  format           String?
  /// Lien d'origine (YouTube, SoundCloud, Bandcamp), normalisé en https.
  externalUrl      String?
  title            String
  /// La personne présente ce média comme une démo d'elle (rapporte de l'XP).
  isDemo           Boolean        @default(false)
  durationSec      Int?
  bytes            Int?
  instrumentId     String?
  instrument       Instrument?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  rejectionReason  String?
  /// Morceaux dont ce média est la maquette (P3-11).
  worksAsDemo      Work[]         @relation("WorkDemo")
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([actorId, status])
  @@index([status, createdAt])
  @@map("media")
}

// ─── MODÉRATION (P1-12) ─────────────────────────────────────────────────────
// File `/moderation` (modérateurs et administrateurs). Règles : `src/lib/moderation/`.

enum ReportTarget {
  ACTOR
  MEDIA
  /// Annonce (P2-02).
  OPPORTUNITY
  /// Lieu de l'annuaire (P2-14a).
  VENUE
  /// Étape de groupe contestée (P3-06).
  MILESTONE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  IMPERSONATION
  NOT_MINE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// Signalement d'un profil ou d'un média. Un seul par signaleur et par cible.
model Report {
  id              String       @id @default(cuid())
  reporterActorId String
  reporter        Actor        @relation("ReportReporter", fields: [reporterActorId], references: [id], onDelete: Cascade)
  targetType      ReportTarget
  targetId        String
  /// Acteur visé (le propriétaire du média, ou le profil lui-même).
  targetActorId   String
  targetActor     Actor        @relation("ReportTargetActor", fields: [targetActorId], references: [id], onDelete: Cascade)
  reason          ReportReason
  /// Texte libre du signaleur, texte brut.
  details         String?
  status          ReportStatus @default(OPEN)
  handledByUserId String?
  handledAt       DateTime?
  decisionNote    String?
  createdAt       DateTime     @default(now())

  @@unique([reporterActorId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetActorId, status])
  @@map("reports")
}

enum SanctionKind {
  WARNING
  SUSPENSION
}

/// Sanction de modération. Active tant que `until` n'est pas passé et
/// qu'elle n'est pas levée ; une sanction active fait retomber la confiance.
model Sanction {
  id              String       @id @default(cuid())
  actorId         String
  actor           Actor        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  kind            SanctionKind
  reason          String
  until           DateTime?
  reportId        String?
  createdByUserId String
  liftedAt        DateTime?
  createdAt       DateTime     @default(now())

  @@index([actorId, kind])
  @@map("sanctions")
}

// ─── INDICATEURS PRODUIT (P1-13, D13) ───────────────────────────────────────

/// Jour où une personne est venue dans son espace (au plus une ligne par
/// jour). Sert à la rétention (conception 05 §2) ; rien d'autre n'est tracé
/// (ni pages, ni durée). Exporté et effacé avec le compte (RGPD).
model ActorActivityDay {
  actorId String
  actor   Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date

  @@id([actorId, day])
  @@index([day])
  @@map("actor_activity_days")
}

// ─── MESSAGERIE (P2-04) ─────────────────────────────────────────────────────
//
// Règles : `src/lib/messaging/` (pur) et `src/lib/server/messaging/`. Le
// premier message à un inconnu est une **demande** (quota de confiance) ;
// la conversation s'ouvre quand le destinataire l'accepte.

/// État d'une conversation pour un participant.
enum ConversationState {
  /// Demande reçue, pas encore acceptée (le destinataire seulement).
  REQUEST
  ACCEPTED
  /// Demande refusée : l'expéditeur ne peut plus écrire.
  DECLINED
}

/// Conversation directe entre deux personnes (une seule par paire).
model Conversation {
  id             String                    @id @default(cuid())
  /// Identifiants des deux acteurs, triés et joints : unicité de la paire.
  pairKey        String                    @unique
  initiatorId    String
  initiator      Actor                     @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  /// Annonce d'origine (P2-02/P2-03) : seule une conversation née d'une
  /// annonce rapporte de l'XP quand elle devient réciproque.
  opportunityId  String?
  /// Première réponse du destinataire (événement `conversation.reciprocated`).
  reciprocatedAt DateTime?
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([initiatorId, createdAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId        String
  actor          Actor             @relation(fields: [actorId], references: [id], onDelete: Cascade)
  state          ConversationState
  /// Lu jusqu'à cette date (non-lus = messages de l'autre postérieurs).
  lastReadAt     DateTime?

  @@id([conversationId, actorId])
  @@index([actorId, state])
  @@map("conversation_participants")
}

/// Message en texte brut. Anonymisation : le texte est effacé, le message
/// reste pour l'historique de l'autre personne.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderActorId  String
  sender         Actor        @relation(fields: [senderActorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── BLOCAGE (P2-05) ────────────────────────────────────────────────────────

/// Blocage d'une personne par une autre. Effet dans les deux sens : ni
/// profil, ni message, ni résultat de recherche entre elles. Les blocages
/// reçus pèsent sur la confiance (conception 02 §7).
model Block {
  blockerActorId String
  blocker        Actor    @relation("BlocksMade", fields: [blockerActorId], references: [id], onDelete: Cascade)
  blockedActorId String
  blocked        Actor    @relation("BlocksReceived", fields: [blockedActorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@id([blockerActorId, blockedActorId])
  @@index([blockedActorId, createdAt])
  @@map("blocks")
}

// ─── ANNONCES (P2-02) ───────────────────────────────────────────────────────
//
// Quêtes émises (conception 02 §8) : « un groupe cherche une batteuse ».
// Règles pures : `src/lib/opportunities/`. Aucune XP à la publication : la
// quête rapporte quand elle est remplie (P2-03, P2-06).

enum OpportunityKind {
  JAM
  RECRUIT_MEMBER
  SESSION_WORK
}

enum OpportunityStatus {
  OPEN
  /// Toutes les places prises (P2-03).
  FILLED
  /// Clôturée par son auteur.
  CLOSED
  EXPIRED
  /// Retirée par la modération.
  REMOVED
}

/// Annonce. Sa zone est la commune de son auteur (`actor_locations`), lue à
/// la volée : aucun point stocké en double.
model Opportunity {
  id            String            @id @default(cuid())
  issuerActorId String
  issuer        Actor             @relation(fields: [issuerActorId], references: [id], onDelete: Cascade)
  /// Personne qui a publié l'annonce au nom d'un groupe (P3-03) ; vide quand
  /// l'émetteur est la personne elle-même. Oublié à l'anonymisation.
  postedById    String?
  postedBy      Actor?            @relation("OpportunityPoster", fields: [postedById], references: [id], onDelete: SetNull)
  kind          OpportunityKind
  status        OpportunityStatus @default(OPEN)
  title         String
  description   String
  /// Instrument recherché (facultatif) et niveau déclaré minimal souhaité.
  instrumentId  String?
  instrument    Instrument?       @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  minLevel      Int?
  /// Genre (slug du référentiel), facultatif.
  genreSlug     String?
  /// Palier musicien minimal (conditions d'éligibilité, jamais l'XP).
  minTier       String?
  /// Rayon de diffusion autour de la commune de l'auteur (km).
  radiusKm      Int               @default(25)
  slots         Int               @default(1)
  /// Date de la jam ou de la session, facultative. Jam publique (P2-14b) :
  /// début exact (heure de Paris convertie en UTC).
  startsAt      DateTime?
  /// Jam publique (P2-14b) : fin, et lieu de l'annuaire (obligatoire, D26).
  endsAt        DateTime?
  venueId       String?
  venue         Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// Jam (P2-14c) : lead désigné par l'hôte (null = l'hôte), et matériel sur
  /// place (copié du lieu à la création, modifiable).
  leadActorId   String?
  lead          Actor?            @relation("JamLead", fields: [leadActorId], references: [id], onDelete: SetNull)
  backline      BacklineItem[]    @default([])
  /// Métier visé (P4-05) : vide pour une annonce de musicien·nes.
  targetTrack     TrackKind?
  /// Spécialité visée dans ce métier (`SoundSpecialty`, `ProducerSpecialty`).
  targetSpecialty String?
  /// Morceau concerné (P4-05), géré par l'émetteur.
  workId          String?
  work            Work?             @relation(fields: [workId], references: [id], onDelete: SetNull)
  expiresAt     DateTime
  closedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  applications Application[]
  jamSpots     JamSpot[]
  attendances  JamAttendance[]
  jamInvites   JamInvite[]
  endorsements JamEndorsement[]

  @@index([status, expiresAt])
  @@index([issuerActorId, status])
  @@index([venueId, startsAt])
  @@map("opportunities")
}

// ─── CANDIDATURES (P2-03) ───────────────────────────────────────────────────

enum ApplicationStatus {
  SENT
  /// Vue par l'auteur de l'annonce.
  SEEN
  SHORTLISTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// Candidature à une annonce (une par annonce et par personne). Son
/// acceptation ouvre une conversation liée à l'annonce : sa réciprocité
/// rapporte de l'XP aux deux (règle `conversation.reciprocated`).
model Application {
  id               String            @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantActorId String
  applicant        Actor             @relation(fields: [applicantActorId], references: [id], onDelete: Cascade)
  message          String
  status           ApplicationStatus @default(SENT)
  /// Conversation ouverte à l'acceptation.
  conversationId   String?
  decidedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([opportunityId, applicantActorId])
  @@index([applicantActorId, createdAt])
  @@map("applications")
}

// ─── COLLABORATIONS (P2-06) ─────────────────────────────────────────────────
//
// Une collaboration rapporte quand **chaque** participant l'a confirmée
// (événement `collaboration.completed`, règle et multiplicateurs dans
// `progression/core`). Règles pures : `src/lib/collaborations/`.

enum CollabKind {
  JAM
  REHEARSAL
  SESSION_WORK
  RECORDING
  PRODUCTION
  GIG
  /// Métiers du son (P4-06).
  MIXING
  MASTERING
  LIVE_SOUND
}

/// Prestation d'une personne d'un métier du son sur une collaboration
/// (P4-06) : elle gagne sur la piste de ce métier (D20).
enum CraftService {
  RECORDING
  MIXING
  MASTERING
  LIVE_SOUND
  PRODUCTION
  ARRANGEMENT
}

enum CollabStatus {
  /// Proposée, en attente de l'autre.
  PROPOSED
  /// Acceptée, date à venir.
  ACCEPTED
  /// Confirmée par tous : a rapporté.
  COMPLETED
  CANCELLED
}

model Collaboration {
  id             String                     @id @default(cuid())
  kind           CollabKind
  status         CollabStatus               @default(PROPOSED)
  title          String
  /// Jour où elle a eu (ou aura) lieu.
  happenedOn     DateTime                   @db.Date
  proposedById   String
  proposedBy     Actor                      @relation("CollaborationProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  /// Annonce et conversation d'origine, si elle en vient.
  opportunityId  String?
  conversationId String?
  /// Morceau sur lequel on a travaillé (P4-06).
  workId         String?
  work           Work?                      @relation(fields: [workId], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  participants CollaborationParticipant[]
  endorsements CollabEndorsement[]

  @@index([conversationId])
  @@map("collaborations")
}

model CollaborationParticipant {
  collaborationId       String
  collaboration         Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  actorId               String
  actor                 Actor         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  acceptedAt            DateTime?
  confirmedCompletionAt DateTime?
  /// Prestation assurée par cette personne (P4-06), vide si elle joue.
  service               CraftService?

  @@id([collaborationId, actorId])
  @@index([actorId])
  @@map("collaboration_participants")
}

/// Modes de jeu (D21) : carrière ou jam (P2-12).
enum PlayMode {
  CAREER
  JAM
}

// ─── MODE JAM : « JE SUIS DISPO » (P2-13) ───────────────────────────────────

enum AvailabilitySlot {
  TONIGHT
  TOMORROW
  WEEKEND
}

/// Disponibilité pour jouer (une active par personne), visible des
/// musicien·nes autour ; s'éteint seule à `endsAt`. Jamais montrée pour un·e
/// mineur·e (D5, D26).
model Availability {
  actorId   String           @id
  actor     Actor            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  slot      AvailabilitySlot
  startsAt  DateTime
  endsAt    DateTime
  /// « Envie d'un bœuf funk » : texte brut, court, facultatif.
  note      String?
  createdAt DateTime         @default(now())

  @@index([endsAt])
  @@map("availabilities")
}

// ─── ANNUAIRE DES LIEUX (P2-14a) ────────────────────────────────────────────

/// Types de lieux publics ou professionnels où se tiennent les jams (D26).
enum VenueKind {
  BAR
  CAFE_CONCERT
  CONCERT_HALL
  OPEN_STAGE
  MJC
  REHEARSAL_SPACE
  STUDIO
  MUSIC_STORE
}

/// Lieu de l'annuaire, ajouté par un membre (D27) et revendiqué plus tard
/// par le lieu lui-même (P5-03). Jamais d'adresse précise : la commune et son
/// centre, aligné sur la grille (comme `actor_locations`).
model Venue {
  id               String    @id @default(cuid())
  name             String
  /// Nom normalisé (minuscules, sans accents ni ponctuation) : doublons.
  nameKey          String
  kind             VenueKind
  communeCode      String
  communeName      String
  departmentCode   String
  /// Centre de la commune aligné sur la grille de ~2 km.
  lat              Float
  lng              Float
  createdById      String
  createdBy        Actor     @relation("VenueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  /// Lieu qui a revendiqué sa fiche (phase 5).
  claimedByActorId String?
  claimedBy        Actor?    @relation("VenueClaimer", fields: [claimedByActorId], references: [id], onDelete: SetNull)
  /// Retiré par la modération.
  removedAt        DateTime?
  /// Validation (P2-14c, D26) : immédiate si l'auteur a la confiance TL1,
  /// sinon à la confirmation d'un second membre ou d'un modérateur. Avant,
  /// le lieu n'est visible que de son auteur et n'accueille aucune jam.
  validatedAt      DateTime?
  /// Second membre qui a confirmé le lieu (null : auteur TL1 ou modérateur).
  confirmedById    String?
  confirmedBy      Actor?    @relation("VenueConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  /// Matériel sur place (P2-14c).
  backline         BacklineItem[] @default([])
  /// SIRET vérifié (P2-14d, D30) : le lieu est validé dès sa vérification.
  siret            String?   @unique
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  jams             Opportunity[]

  @@unique([communeCode, nameKey])
  @@index([departmentCode])
  @@index([createdById])
  @@index([validatedAt])
  @@map("venues")
}

// ─── JAMS PUBLIQUES (P2-14b) ────────────────────────────────────────────────

/// Places souhaitées par instrument pour une jam (« il manque une batterie »).
model JamSpot {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  instrumentId  String
  instrument    Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  count         Int         @default(1)

  @@id([opportunityId, instrumentId])
  @@map("jam_spots")
}

/// « Je viens » à une jam : sans acceptation, retirable, sans XP (D27).
/// « J'y étais » s'y ajoutera (P2-15).
model JamAttendance {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actorId       String
  actor         Actor       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  /// Instrument joué (P2-14c), facultatif : prend une place ouverte.
  instrumentId  String?
  instrument    Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  /// « J'y étais » (P2-15, D27) : sans XP, ouvre les appréciations 7 jours.
  attendedAt    DateTime?
  /// Faux présent retiré par l'hôte : ses appréciations sont reprises.
  removedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@id([opportunityId, actorId])
  @@index([actorId])
  @@map("jam_attendances")
}

// ─── FORMATION ET MATÉRIEL (P2-14c) ─────────────────────────────────────────

/// Matériel qu'un lieu met à disposition (libellés : `#lib/jam/lineup`).
enum BacklineItem {
  DRUMS
  BASS_AMP
  GUITAR_AMP
  KEYBOARD
  PA_MICS
  CABLES
}

enum JamInviteStatus {
  INVITED
  ACCEPTED
  DECLINED
}

/// Place réservée par le lead : en attente ou acceptée, elle n'est pas
/// ouverte à « Je viens ». Sans XP (D27).
model JamInvite {
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actorId       String
  actor         Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  instrumentId  String
  instrument    Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  status        JamInviteStatus @default(INVITED)
  createdAt     DateTime        @default(now())
  respondedAt   DateTime?

  @@id([opportunityId, actorId])
  @@index([actorId, status])
  @@map("jam_invites")
}

// ─── ÉTABLISSEMENTS DE RÉFÉRENCE (P2-14d) ───────────────────────────────────

/// Établissement de la base Sirene (API Recherche d'entreprises), importé
/// pour Toulouse Métropole (`npm run seed:etablissements`, D30). Sert aux
/// suggestions et à la vérification d'un lieu ; ne remplit pas l'annuaire.
/// Jamais de nom de personne ni d'adresse : enseigne et commune seulement.
model Establishment {
  siret          String   @id
  siren          String
  name           String
  /// Nom normalisé (`venueNameKey`), pour les suggestions.
  nameKey        String
  naf            String
  communeCode    String
  communeName    String
  departmentCode String
  active         Boolean
  updatedAt      DateTime @updatedAt

  @@index([communeCode, nameKey])
  @@map("establishments")
}

// ─── APRÈS LA JAM : APPRÉCIATIONS (P2-15) ───────────────────────────────────

/// Qualités qu'un·e présent·e peut saluer (libellés : `#lib/jam/afterJam`).
enum JamQuality {
  GROOVE
  LISTENING
  IMPRO
  RELIABLE
}

/// Appréciation d'un·e présent·e à un·e autre, pendant les 7 jours après la
/// jam (D27) : une qualité ou un instrument, une par paire et par jam. Elle
/// émet `endorsement.received` (≈ 40 XP, rendements décroissants par paire).
/// Reprise (`revokedAt`, transaction négative liée) si l'hôte retire un faux
/// présent.
model JamEndorsement {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromActorId   String
  from          Actor       @relation("EndorsementFrom", fields: [fromActorId], references: [id], onDelete: Cascade)
  toActorId     String
  to            Actor       @relation("EndorsementTo", fields: [toActorId], references: [id], onDelete: Cascade)
  quality       JamQuality?
  instrumentId  String?
  instrument    Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  /// Événement `endorsement.received` émis (pour reprendre l'XP).
  eventId       String?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, fromActorId, toActorId])
  @@index([toActorId])
  @@index([fromActorId])
  @@map("jam_endorsements")
}

// ─── RÉSEAU MUSICAL (P2-16) ──────────────────────────────────────────────────

/// Réseau musical : les gens avec qui l'on a vraiment joué (présence
/// commune à une jam, collaboration confirmée) et que l'on garde
/// (« Garder le contact »). Lien à sens unique, visible de son seul
/// propriétaire ; il fait remonter la personne en tête des recherches et
/// des invitations. Jamais l'XP.
model MusicalTie {
  ownerId   String
  owner     Actor    @relation("TieOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId String
  contact   Actor    @relation("TieContact", fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([ownerId, contactId])
  @@index([contactId])
  @@map("musical_ties")
}

// ─── APPRÉCIATIONS APRÈS UNE COLLABORATION (P2-07) ──────────────────────────

/// Qualité saluée après une collaboration confirmée (P2-07).
enum CollabQuality {
  RELIABLE
  ON_TIME
  PREPARED
  GOOD_VIBE
}

/// Appréciation après une collaboration confirmée par tous (P2-07, D27) :
/// une qualité ou un instrument déclaré, une par paire et par
/// collaboration, TL1 requise. Reprise par son autrice ou son auteur
/// (`revokedAt`, XP repris par transaction négative liée) ; elle peut être
/// redonnée, avec les rendements décroissants de la paire.
model CollabEndorsement {
  id              String         @id @default(cuid())
  collaborationId String
  collaboration   Collaboration  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  fromActorId     String
  from            Actor          @relation("CollabEndorsementFrom", fields: [fromActorId], references: [id], onDelete: Cascade)
  toActorId       String
  to              Actor          @relation("CollabEndorsementTo", fields: [toActorId], references: [id], onDelete: Cascade)
  quality         CollabQuality?
  instrumentId    String?
  instrument      Instrument?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  /// Événement `endorsement.received` émis (pour reprendre l'XP).
  eventId         String?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([collaborationId, fromActorId, toActorId])
  @@index([toActorId])
  @@index([fromActorId])
  @@map("collab_endorsements")
}

// ─── RÉPUTATION (P2-08) ─────────────────────────────────────────────────────

/// Carte de réputation (conception 02 §1) : ce que d'autres confirment,
/// recalculée après chaque événement qui la touche, chaque nuit
/// (`/api/jobs/reputation`) et à la demande. Projection reconstructible :
/// rien ici n'est saisi. L'XP n'entre dans aucun de ces champs.
model ReputationSnapshot {
  actorId              String   @id
  actor                Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  confirmedCollabs     Int
  distinctCounterparts Int
  /// Concerts corroborés et sorties vérifiées (étapes de groupe).
  corroboratedGigs     Int
  verifiedReleases     Int
  bands                Int
  /// Personnes distinctes qui ont laissé une appréciation encore active.
  distinctEndorsers    Int
  /// Appréciations actives par libellé : `[{ label, count }]`, des plus fréquentes.
  endorsementsByKind   Json
  /// `FAST` (< 24 h), `DAY` (< 48 h), `SLOW`, ou `null` sans assez de demandes reçues.
  responseBucket       String?
  /// Tri de la recherche uniquement. Jamais affiché, jamais renvoyé au client.
  internalScore        Float
  computedAt           DateTime

  @@index([internalScore])
  @@map("reputation_snapshots")
}

// ─── NOTIFICATIONS (P2-09) ──────────────────────────────────────────────────

/// Ce qui attend une réaction de la personne. Les gains, niveaux et succès
/// ont leurs célébrations (P2-11) et les messages leur pastille : ils
/// n'entrent pas ici, seulement dans le digest email (P2-09b).
enum NotificationType {
  CONTACT_REQUEST
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  COLLAB_TO_CONFIRM
  ENDORSEMENT
  JAM_INVITE
  /// Invitation à rejoindre un groupe (P3-01).
  BAND_INVITE
  /// Demande pour rejoindre un de ses groupes (P3-01).
  BAND_REQUEST
  /// Nouveau membre dans un de ses groupes (P3-01).
  BAND_JOINED
  /// On te crédite sur un morceau : confirme ton rôle (P3-11).
  WORK_CREDIT
  /// Un groupe te demande de confirmer une de ses étapes (P3-05).
  MILESTONE_ATTEST
  /// Invitation à une discussion de groupe (P3-16c).
  GROUP_DISCUSSION_INVITE
  /// Préférence d'email seulement (P2-09b) : jamais une ligne de `Notification`.
  MESSAGES
  PROGRESS
}

/// Notification dans l'app (cloche). Le texte est composé à l'affichage
/// (`#lib/notifications/types`) : le nom de l'autre personne est relu,
/// « Compte supprimé » après une anonymisation.
model Notification {
  id               String           @id @default(cuid())
  recipientActorId String
  recipient        Actor            @relation("NotificationRecipient", fields: [recipientActorId], references: [id], onDelete: Cascade)
  type             NotificationType
  fromActorId      String?
  from             Actor?           @relation("NotificationFrom", fields: [fromActorId], references: [id], onDelete: Cascade)
  /// Page où agir (chemin interne).
  href             String
  /// Titre de l'annonce, de la jam ou de la collaboration, au moment du fait.
  title            String?
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  @@index([recipientActorId, readAt])
  @@index([recipientActorId, createdAt])
  @@map("notifications")
}

/// Préférence par type : seules les exceptions sont enregistrées (tout est
/// activé par défaut). `email` sert au digest (P2-09b).
model NotificationPreference {
  actorId String
  actor   Actor            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  type    NotificationType
  inApp   Boolean          @default(true)
  email   Boolean          @default(true)

  @@id([actorId, type])
  @@map("notification_preferences")
}

// ─── DÉTECTION DE COLLUSION (P2-10) ─────────────────────────────────────────

enum CollusionStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

/// Cercle fermé repéré par le job nocturne (`/api/jobs/collusion`) : un groupe
/// de personnes qui ne collaborent et ne s'apprécient qu'entre elles. Mis en
/// revue dans `/moderation`, **jamais sanctionné automatiquement**.
model CollusionCase {
  id              String          @id @default(cuid())
  /// Membres, triés : la même composante n'ouvre qu'un seul cas.
  memberIds       String[]
  memberKey       String          @unique
  /// Collaborations et appréciations entre membres sur la fenêtre observée.
  interactions    Int
  /// Liens existants / liens possibles (0 à 1).
  density         Float
  /// Adresses IP de session communes à au moins deux membres.
  sharedIps       Int
  status          CollusionStatus @default(OPEN)
  detectedAt      DateTime        @default(now())
  lastSeenAt      DateTime        @default(now())
  handledByUserId String?
  handledAt       DateTime?
  decisionNote    String?

  @@index([status, sharedIps])
  @@map("collusion_cases")
}

// ─── SUGGESTIONS DE MUSICIEN·NES (P2-18) ────────────────────────────────────

/// « Pas intéressé·e » : la personne ne sera plus suggérée à `ownerId`. Elle
/// reste trouvable par la recherche ; seule la suggestion disparaît.
model SuggestionDismissal {
  ownerId   String
  owner     Actor    @relation("SuggestionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  actorId   String
  actor     Actor    @relation("SuggestionTarget", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([ownerId, actorId])
  @@map("suggestion_dismissals")
}

// ─── GROUPES ET ADHÉSIONS (P3-01) ───────────────────────────────────────────

/// Type d'organisation : le groupe d'abord, les autres métiers ensuite
/// (studio, lieu, label…, conception 04).
enum OrgKind {
  BAND
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

/// INVITED et REQUESTED sont en attente ; ACTIVE est une adhésion en cours ;
/// LEFT, REMOVED et DECLINED sont closes. Un retour crée une nouvelle ligne :
/// l'historique garde chaque période.
enum MembershipStatus {
  INVITED
  REQUESTED
  ACTIVE
  LEFT
  REMOVED
  DECLINED
}

/// Organisation : un `Actor` de type ORGANIZATION (handle, nom, présentation,
/// XP sur la piste BAND). Un groupe a toujours un OWNER tant qu'il n'est pas
/// dissous (`src/lib/server/bands/service.ts`, seul point d'écriture).
model Organization {
  actorId     String       @id
  actor       Actor        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  kind        OrgKind
  /// Formation : la 2ᵉ adhésion active (étape « Formation » vérifiée).
  formedAt    DateTime?
  /// Dissous par sa dernière personne : l'historique reste lisible.
  dissolvedAt DateTime?
  createdAt   DateTime     @default(now())
  /// Organisation vérifiée à la main (P3-09, conception 02 §4) : SIRET et lien
  /// officiel contrôlés par la modération. Un statut accordé, pas gagné.
  verifiedAt  DateTime?
  memberships Membership[]
  verifications OrganizationVerification[]

  @@map("organizations")
}

/// Une période d'appartenance d'une personne à un groupe, ou une invitation
/// ou une demande en attente. Au plus une ligne ouverte (INVITED, REQUESTED,
/// ACTIVE) par personne et par groupe, garanti par le service sous verrou.
model Membership {
  id          String           @id @default(cuid())
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [actorId], onDelete: Cascade)
  /// Acteur de la personne.
  personId    String
  person      Actor            @relation("MembershipPerson", fields: [personId], references: [id], onDelete: Cascade)
  role        OrgRole          @default(MEMBER)
  /// Ce que la personne fait dans le groupe (« basse, chœurs »), texte brut.
  title       String?
  status      MembershipStatus
  /// Qui a invité (invitation) ; vide pour une demande ou une fondation.
  invitedById String?
  invitedBy   Actor?           @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  /// Début et fin de la période (l'historique attribue les étapes aux
  /// membres présents à leur date, P3-08).
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orgId, status])
  @@index([personId, status])
  @@map("memberships")
}

// ─── MORCEAUX (P3-11, D35) ──────────────────────────────────────────────────

/// Idée (visible de son équipe) puis composé (public, avec ses crédits).
enum WorkState {
  IDEA
  COMPOSED
}

/// Composé seul·e : déclaré, sans XP. À plusieurs (≥2 crédits confirmés) :
/// corroboré, et chaque contributeur confirmé reçoit sa part (D35).
enum WorkProof {
  DECLARED
  CORROBORATED
}

enum WorkRoleKind {
  INSTRUMENT
  COMPOSITION
  LYRICS
  ARRANGEMENT
}

/// Morceau. Porté par une personne ou un groupe (`ownerId`, un `Actor`) ;
/// seul point d'écriture : `src/lib/server/works/service.ts`.
model Work {
  id          String         @id @default(cuid())
  ownerId     String
  owner       Actor          @relation("WorkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Personne qui a créé le morceau (au nom du groupe le cas échéant).
  createdById String?
  createdBy   Actor?         @relation("WorkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  state       WorkState      @default(IDEA)
  /// Renseigné au passage à « composé ».
  proof       WorkProof?
  /// Maquette : un média du porteur (lien externe), jamais une démo à XP.
  demoMediaId String?
  demoMedia   Media?         @relation("WorkDemo", fields: [demoMediaId], references: [id], onDelete: SetNull)
  /// Maquette ajoutée depuis le morceau : elle suit sa visibilité (cachée
  /// des listes publiques tant que le morceau est une idée).
  demoFromWork Boolean       @default(false)
  composedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  genres       WorkGenre[]
  contributors WorkContributor[]
  roles        WorkRole[]
  milestones   Milestone[]
  /// Étapes de production (P4-06) : première collaboration terminée de chaque type.
  recordedAt   DateTime?
  mixedAt      DateTime?
  masteredAt   DateTime?
  producedAt   DateTime?
  collaborations Collaboration[]
  /// Annonces liées au morceau (P4-05).
  opportunities Opportunity[]

  @@index([ownerId, state])
  @@map("works")
}

model WorkGenre {
  workId  String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([workId, genreId])
  @@index([genreId])
  @@map("work_genres")
}

/// Personne créditée sur un morceau. Le crédit n'existe publiquement qu'une
/// fois confirmé par elle (`confirmedAt`) : confirmer vaut consentement.
model WorkContributor {
  id          String     @id @default(cuid())
  workId      String
  work        Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  personId    String
  person      Actor      @relation("WorkContributorPerson", fields: [personId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   Actor?     @relation("WorkContributorInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  confirmedAt DateTime?
  createdAt   DateTime   @default(now())
  roles       WorkRole[]

  @@unique([workId, personId])
  @@index([personId])
  @@map("work_contributors")
}

/// Rôle sur un morceau. Sans contributeur, il est « à pourvoir » (bouton
/// « Recruter »). Un instrument vient du référentiel.
model WorkRole {
  id            String           @id @default(cuid())
  workId        String
  work          Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  kind          WorkRoleKind
  instrumentId  String?
  instrument    Instrument?      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  contributorId String?
  contributor   WorkContributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([workId])
  @@index([contributorId])
  @@map("work_roles")
}

// ─── ÉTAPES DE GROUPE (P3-04, D41) ──────────────────────────────────────────

/// Niveau de preuve d'une étape (conception 02 §4). Le passage de l'un à
/// l'autre rapporte la différence d'XP (`milestone.attested`).
enum MilestoneProof {
  DECLARED
  CORROBORATED
  VERIFIED
}

/// Référentiel des étapes, chargé par `npm run seed:referentiels`
/// (`prisma/seed-data/milestones.js`, rejouable). Le barème d'XP vit dans le
/// moteur (`progression/core/bareme.ts`), pas ici.
model MilestoneDefinition {
  /// Clé du moteur (`FIRST_GIG`…).
  id         String      @id
  ordinal    Int
  label      String
  /// formation | work | declare | later (`#lib/milestones/rules`).
  mode       String
  /// Version du référentiel qui a écrit la ligne.
  version    Int
  active     Boolean     @default(true)
  updatedAt  DateTime    @updatedAt
  milestones Milestone[]

  @@map("milestone_definitions")
}

/// Une étape franchie par un groupe : une seule par groupe et par étape
/// (« premières fois »). Seul point d'écriture :
/// `src/lib/server/milestones/service.ts`.
model Milestone {
  id                String              @id @default(cuid())
  definitionId      String
  definition        MilestoneDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  bandId            String
  band              Actor               @relation("MilestoneBand", fields: [bandId], references: [id], onDelete: Cascade)
  proof             MilestoneProof
  /// Date de l'étape (le jour, à midi UTC), pas celle de la déclaration.
  occurredAt        DateTime
  /// Précision publique facultative (« Au Bikini »).
  note              String?
  /// Qui l'a déclarée ; vide pour une étape automatique ou après RGPD.
  declaredById      String?
  declaredBy        Actor?              @relation("MilestoneDeclarer", fields: [declaredById], references: [id], onDelete: SetNull)
  /// Morceau qui porte « Première composition ».
  workId            String?
  work              Work?               @relation(fields: [workId], references: [id], onDelete: SetNull)
  /// Référence d'une sortie vérifiée par MusicBrainz (P3-07).
  releaseReferenceKind String?
  releaseReference     String?
  releaseUrl           String?
  definitionVersion Int
  /// Contestée (P3-06) : gelée jusqu'à la décision de la modération. Elle ne
  /// s'affiche plus comme prouvée et ne reçoit plus de preuve.
  frozenAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  attestations      MilestoneAttestation[]
  evidence          MilestoneEvidence[]

  @@unique([bandId, definitionId])
  @@index([declaredById])
  @@index([workId])
  @@map("milestones")
}

// ─── PREUVES DES ÉTAPES (P3-05, D43) ────────────────────────────────────────

/// Qui confirme : un autre membre présent à la date, ou une personne hors
/// du groupe (TL1, jamais membre ni ancien membre).
enum AttesterRole {
  MEMBER
  OUTSIDER
}

enum AttestationStatus {
  REQUESTED
  CONFIRMED
  DECLINED
}

/// Lien joint à une étape : l'événement ou l'affiche (concert), l'écoute
/// (démo publique, relue par la modération), un extrait (enregistrement).
enum EvidenceKind {
  EVENT
  LISTEN
  RECORDING
}

enum EvidenceStatus {
  PENDING
  ACCEPTED
  REJECTED
  VERIFIED
}

/// Une demande de confirmation d'étape, et sa réponse. Une par étape et
/// par personne. Seul point d'écriture : `src/lib/server/milestones/proofs.ts`.
model MilestoneAttestation {
  id            String            @id @default(cuid())
  milestoneId   String
  milestone     Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  attesterId    String
  attester      Actor             @relation("MilestoneAttester", fields: [attesterId], references: [id], onDelete: Cascade)
  /// Personne de la gestion qui a demandé ; vide après RGPD.
  requestedById String?
  requestedBy   Actor?            @relation("MilestoneAttestationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  role          AttesterRole
  status        AttestationStatus @default(REQUESTED)
  createdAt     DateTime          @default(now())
  answeredAt    DateTime?

  @@unique([milestoneId, attesterId])
  @@index([attesterId, status])
  @@index([requestedById])
  @@map("milestone_attestations")
}

/// Un lien joint à une étape. Une démo publique attend la modération
/// (`PENDING`) ; les autres liens sont acceptés tels quels.
model MilestoneEvidence {
  id               String         @id @default(cuid())
  milestoneId      String
  milestone        Milestone      @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  kind             EvidenceKind
  url              String
  addedById        String?
  addedBy          Actor?         @relation("MilestoneEvidenceAdder", fields: [addedById], references: [id], onDelete: SetNull)
  status           EvidenceStatus
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  createdAt        DateTime       @default(now())

  @@index([milestoneId])
  @@index([status, createdAt])
  @@index([addedById])
  @@map("milestone_evidence")
}


// ─── CONTACTS (P3-16b, D45, D46) ────────────────────────────────────────────

/// Groupe de contacts privé (« Projet funk ») : un projet potentiel. Seul
/// point d'écriture : `src/lib/server/contacts/service.ts`.
model ContactGroup {
  id        String               @id @default(cuid())
  ownerId   String
  owner     Actor                @relation("ContactGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ContactGroupMember[]

  @@index([ownerId])
  @@map("contact_groups")
}

/// Un contact dans un groupe (toujours un contact de son propriétaire).
model ContactGroupMember {
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   Actor        @relation("ContactGroupContact", fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime     @default(now())

  @@id([groupId, contactId])
  @@index([contactId])
  @@map("contact_group_members")
}

// ─── DISCUSSIONS DE GROUPE (P3-16c, D46) ────────────────────────────────────

enum GroupDiscussionMemberState {
  /// Invitation reçue : la personne ne voit encore rien de la discussion.
  INVITED
  ACTIVE
  /// « Non merci » : pas de nouvelle invitation dans cette discussion.
  DECLINED
  LEFT
}

/// Discussion à plusieurs, ouverte depuis un groupe de contacts. Chaque
/// personne y entre sur invitation acceptée. Seul point d'écriture :
/// `src/lib/server/discussions/service.ts`.
model GroupDiscussion {
  id             String                   @id @default(cuid())
  title          String
  /// Auteur : seule personne qui invite.
  creatorId      String
  creator        Actor                    @relation("GroupDiscussionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  /// Groupe de contacts d'origine (privé à l'auteur, jamais montré aux autres).
  contactGroupId String?
  lastMessageAt  DateTime                 @default(now())
  createdAt      DateTime                 @default(now())

  members  GroupDiscussionMember[]
  messages GroupDiscussionMessage[]

  @@index([creatorId])
  @@map("group_discussions")
}

model GroupDiscussionMember {
  discussionId String
  discussion   GroupDiscussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  actorId      String
  actor        Actor                      @relation("GroupDiscussionMemberActor", fields: [actorId], references: [id], onDelete: Cascade)
  state        GroupDiscussionMemberState
  invitedAt    DateTime                   @default(now())
  /// Entrée dans la discussion : les messages d'avant restent visibles.
  joinedAt     DateTime?
  leftAt       DateTime?
  lastReadAt   DateTime?

  @@id([discussionId, actorId])
  @@index([actorId, state])
  @@map("group_discussion_members")
}

/// Message en texte brut. Anonymisation : le texte est effacé, le message
/// reste pour l'historique des autres.
model GroupDiscussionMessage {
  id            String          @id @default(cuid())
  discussionId  String
  discussion    GroupDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  senderActorId String
  sender        Actor           @relation("GroupDiscussionMessageSender", fields: [senderActorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime        @default(now())

  @@index([discussionId, createdAt])
  @@index([senderActorId])
  @@map("group_discussion_messages")
}

// ─── CARRIÈRE (P3-12) ───────────────────────────────────────────────────────

enum CareerAmbition {
  /// Jouer en groupe pour le plaisir (actes I et II).
  PLAY_BAND
  /// Monter sur scène (actes II et V).
  STAGE
  /// Enregistrer et sortir sa musique (actes III, IV et VI).
  RECORD
  /// Devenir pro (toute la carte).
  PRO
  /// Accompagner les autres (autres métiers).
  SUPPORT
}

// ─── VÉRIFICATION DES ORGANISATIONS (P3-09) ─────────────────────────────────

enum OrgVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Demande de vérification d'une organisation (groupe au MVP ; studios,
/// lieux, labels en phase 5). La modération contrôle le SIRET et le lien
/// officiel. Seul point d'écriture : `src/lib/server/organizations/verification.ts`.
model OrganizationVerification {
  id               String                @id @default(cuid())
  orgId            String
  org              Organization          @relation(fields: [orgId], references: [actorId], onDelete: Cascade)
  /// Personne de la gestion qui a demandé ; vide après RGPD.
  requestedById    String?
  requestedBy      Actor?                @relation("OrgVerificationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  siret            String
  /// Site ou réseau social officiel (https).
  officialUrl      String
  status           OrgVerificationStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  /// Motif d'un refus, montré à la gestion du groupe.
  reason           String?

  @@index([status, createdAt])
  @@index([orgId, createdAt])
  @@index([siret])
  @@map("organization_verifications")
}

// ─── Métiers du son (P4-02) ─────────────────────────────────────────────

enum SoundSpecialty {
  RECORDING
  MIXING
  MASTERING
  LIVE_FOH
  LIVE_MONITORS
}

enum CraftMobility {
  OWN_PLACE
  ON_SITE
  REMOTE
}

/// Profil d'ingé son, déclaratif (conception 08 §5). Trouvable dans la
/// recherche par métier dès qu'une spécialité est cochée.
model SoundEngineerProfile {
  personId    String           @id
  person      Person           @relation(fields: [personId], references: [actorId], onDelete: Cascade)
  specialties SoundSpecialty[]
  mobility    CraftMobility[]
  /// Matériel, texte libre (600 caractères au plus).
  gear        String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("sound_engineer_profiles")
}

// ─── Producteur·rice (P4-04) ────────────────────────────────────────────

enum ProducerSpecialty {
  PRODUCTION
  ARRANGEMENT
  BEATMAKING
}

/// Profil de producteur·rice, déclaratif (conception 08 §7). Trouvable dans
/// la recherche par métier dès qu'une spécialité est cochée.
model ProducerProfile {
  personId    String              @id
  person      Person              @relation(fields: [personId], references: [actorId], onDelete: Cascade)
  specialties ProducerSpecialty[]
  mobility    CraftMobility[]
  /// Logiciels, texte libre (300 caractères au plus).
  software    String              @default("")
  /// Tarifs indicatifs, une phrase (160 caractères au plus).
  rate        String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  genres      ProducerGenre[]

  @@map("producer_profiles")
}

/// Style produit (genre du référentiel), 5 au plus par profil.
model ProducerGenre {
  personId String
  profile  ProducerProfile @relation(fields: [personId], references: [personId], onDelete: Cascade)
  genreId  String
  genre    Genre           @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([personId, genreId])
  @@index([genreId])
  @@map("producer_genres")
}

/// Travail en écoute ajouté par la personne sur son profil de métier
/// (avant / après, production). Déclaratif : les crédits confirmés par les
/// artistes viendront avec P4-07.
model CraftReference {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [actorId], onDelete: Cascade)
  track     TrackKind
  title     String
  url       String
  position  Int
  createdAt DateTime  @default(now())

  @@index([personId, track, position])
  @@map("craft_references")
}
